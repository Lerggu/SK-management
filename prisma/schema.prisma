enum MaterialStatus {
  RECEIVED
  STORED
  AT_WORKFACE
  INSTALLED
  RETURNED
}

/// Material batch moving delivery → storage → workface → installed. Every
/// status change is an append-only movement row.
model MaterialBatch {
  id          String         @id @default(uuid(7)) @db.Uuid
  companyId   String         @map("company_id") @db.Uuid
  projectId   String         @map("project_id") @db.Uuid
  siteId      String         @map("site_id") @db.Uuid
  code        String
  material    String
  quantity    Decimal        @db.Decimal(12, 2)
  unit        String
  status      MaterialStatus @default(RECEIVED)
  deliveryId  String?        @map("delivery_id") @db.Uuid
  activityId  String?        @map("activity_id") @db.Uuid
  locationId  String?        @map("location_id") @db.Uuid
  notes       String?
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?        @map("created_by") @db.Uuid
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById String?        @map("updated_by") @db.Uuid
  archivedAt  DateTime?      @map("archived_at") @db.Timestamptz(6)

  company   Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  site      Site               @relation(fields: [companyId, projectId, siteId], references: [companyId, projectId, id], onDelete: Restrict)
  delivery  Delivery?          @relation(fields: [companyId, siteId, deliveryId], references: [companyId, siteId, id], onDelete: Restrict)
  activity  TaktActivity?      @relation(fields: [companyId, siteId, activityId], references: [companyId, siteId, id], onDelete: Restrict)
  location  LogisticsLocation? @relation(fields: [companyId, siteId, locationId], references: [companyId, siteId, id], onDelete: Restrict)
  movements MaterialMovement[]

  @@unique([companyId, id])
  @@unique([companyId, siteId, id])
  @@unique([companyId, code])
  @@index([companyId, siteId, status])
  @@map("material_batches")
}

/// Append-only (DB trigger blocks UPDATE/DELETE).
model MaterialMovement {
  id         String          @id @default(uuid(7)) @db.Uuid
  companyId  String          @map("company_id") @db.Uuid
  siteId     String          @map("site_id") @db.Uuid
  batchId    String          @map("batch_id") @db.Uuid
  fromStatus MaterialStatus? @map("from_status")
  toStatus   MaterialStatus  @map("to_status")
  locationId String?         @map("location_id") @db.Uuid
  activityId String?         @map("activity_id") @db.Uuid
  note       String?
  movedAt    DateTime        @default(now()) @map("moved_at") @db.Timestamptz(6)
  movedById  String?         @map("moved_by") @db.Uuid

  batch    MaterialBatch      @relation(fields: [companyId, siteId, batchId], references: [companyId, siteId, id], onDelete: Restrict)
  location LogisticsLocation? @relation(fields: [companyId, siteId, locationId], references: [companyId, siteId, id], onDelete: Restrict)
  activity TaktActivity?      @relation(fields: [companyId, siteId, activityId], references: [companyId, siteId, id], onDelete: Restrict)

  @@index([companyId, batchId, movedAt])
  @@map("material_movements")
}

enum CableDrumStatus {
  IN_STOCK
  IN_USE
  EMPTY
  RETURNED
}

/// Cable drum; remaining length is maintained by a trigger from append-only
/// pulls (metres, owner decision) and can never go negative (CHECK).
model CableDrum {
  id                 String          @id @default(uuid(7)) @db.Uuid
  companyId          String          @map("company_id") @db.Uuid
  projectId          String          @map("project_id") @db.Uuid
  siteId             String          @map("site_id") @db.Uuid
  code               String
  manufacturer       String?
  cableType          String          @map("cable_type")
  originalLengthM    Decimal         @map("original_length_m") @db.Decimal(10, 1)
  remainingM         Decimal         @map("remaining_m") @db.Decimal(10, 1)
  weightKg           Decimal?        @map("weight_kg") @db.Decimal(10, 1)
  dimensions         String?
  status             CableDrumStatus @default(IN_STOCK)
  locationId         String?         @map("location_id") @db.Uuid
  reservedActivityId String?         @map("reserved_activity_id") @db.Uuid
  deliveryId         String?         @map("delivery_id") @db.Uuid
  receivedDate       DateTime?       @map("received_date") @db.Date
  nextInspectionDate DateTime?       @map("next_inspection_date") @db.Date
  notes              String?
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById        String?         @map("created_by") @db.Uuid
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById        String?         @map("updated_by") @db.Uuid
  archivedAt         DateTime?       @map("archived_at") @db.Timestamptz(6)

  company          Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  site             Site               @relation(fields: [companyId, projectId, siteId], references: [companyId, projectId, id], onDelete: Restrict)
  location         LogisticsLocation? @relation(fields: [companyId, siteId, locationId], references: [companyId, siteId, id], onDelete: Restrict)
  reservedActivity TaktActivity?      @relation(fields: [companyId, siteId, reservedActivityId], references: [companyId, siteId, id], onDelete: Restrict)
  delivery         Delivery?          @relation(fields: [companyId, siteId, deliveryId], references: [companyId, siteId, id], onDelete: Restrict)
  pulls            CablePull[]

  @@unique([companyId, id])
  @@unique([companyId, siteId, id])
  @@unique([companyId, code])
  @@index([companyId, siteId, status])
  @@map("cable_drums")
}

/// Append-only pull log in metres (DB trigger blocks UPDATE/DELETE).
model CablePull {
  id          String   @id @default(uuid(7)) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  siteId      String   @map("site_id") @db.Uuid
  drumId      String   @map("drum_id") @db.Uuid
  activityId  String?  @map("activity_id") @db.Uuid
  lengthM     Decimal  @map("length_m") @db.Decimal(10, 1)
  pulledOn    DateTime @map("pulled_on") @db.Date
  note        String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?  @map("created_by") @db.Uuid

  drum     CableDrum     @relation(fields: [companyId, siteId, drumId], references: [companyId, siteId, id], onDelete: Restrict)
  activity TaktActivity? @relation(fields: [companyId, siteId, activityId], references: [companyId, siteId, id], onDelete: Restrict)

  @@index([companyId, drumId, pulledOn])
  @@map("cable_pulls")
}

