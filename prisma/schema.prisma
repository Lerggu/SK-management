// SK Management — V1 Foundation schema.
//
// Conventions (see docs/adr):
// - UUIDv7 primary keys generated by Prisma (`uuid(7)`).
// - All timestamps are `timestamptz` and stored in UTC.
// - Company-scoped tables carry `company_id` and expose `@@unique([companyId, id])`
//   so that child tables can reference them with composite foreign keys
//   (`(company_id, parent_id) -> parent(company_id, id)`). This makes
//   cross-company references impossible at the database level.
// - Records are archived (`archived_at`) instead of hard-deleted.
// - Money is numeric(14,2) plus an ISO-4217 currency code.
// - created_by / updated_by hold user ids without FK relations to keep the
//   audit columns cheap; the audit trail is authoritative for "who".
//
// Raw-SQL objects that Prisma does not model (triggers, check constraints,
// partial unique indexes) live in migrations and are listed in
// docs/adr/0004-database-integrity.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────── Enums

enum UserStatus {
  ACTIVE
  DISABLED
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum ProjectAccess {
  ALL
  ASSIGNED
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
}

enum SiteStatus {
  ACTIVE
  CLOSED
}

enum ResourceStatus {
  ACTIVE
  INACTIVE
}

enum EmploymentType {
  EMPLOYEE
  CONTRACTOR
  TEMPORARY
}

enum EquipmentCategory {
  CRANE
  TELEHANDLER
  EXCAVATOR
  WHEEL_LOADER
  FORKLIFT
  AERIAL_PLATFORM
  VEHICLE
  LIFTING_ACCESSORY
  CABLE_EQUIPMENT
  OTHER
}

enum EquipmentStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  OUT_OF_SERVICE
}

enum RateType {
  COST
  BILLING
}

enum RateUnit {
  HOUR
  DAY
}

enum DocumentCategory {
  CONTRACT
  DRAWING
  RAMS
  LIFT_PLAN
  ELECTRICAL_PLAN
  INSPECTION
  CERTIFICATE
  MANUAL
  OTHER
}

enum DocumentVersionStatus {
  CURRENT
  SUPERSEDED
}

enum ApprovalState {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum DocumentLinkEntity {
  PROJECT
  SITE
  EMPLOYEE
  EQUIPMENT
}

enum ActorType {
  USER
  SYSTEM
}

// ─────────────────────────────────────────────────────────────── Identity

model Organization {
  id          String    @id @default(uuid(7)) @db.Uuid
  slug        String    @unique
  name        String
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById String?   @map("updated_by") @db.Uuid
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(6)

  companies   Company[]
  memberships OrganizationMembership[]

  @@map("organizations")
}

model Company {
  id              String    @id @default(uuid(7)) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  slug            String    @unique
  name            String
  businessId      String?   @map("business_id")
  defaultCurrency String    @default("EUR") @map("default_currency") @db.Char(3)
  defaultLocale   String    @default("fi") @map("default_locale")
  timezone        String    @default("Europe/Helsinki")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById     String?   @map("created_by") @db.Uuid
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById     String?   @map("updated_by") @db.Uuid
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(6)

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberships    CompanyMembership[]
  roles          Role[]
  projects       Project[]
  sites          Site[]
  employees      Employee[]
  employeeRates  EmployeeRate[]
  equipmentTypes EquipmentType[]
  equipment      Equipment[]
  equipmentRates EquipmentRate[]
  documents      Document[]

  @@index([organizationId])
  @@map("companies")
}

model User {
  id            String     @id @default(uuid(7)) @db.Uuid
  email         String     @unique
  name          String?
  emailVerified DateTime?  @map("email_verified") @db.Timestamptz(6)
  image         String?
  locale        String?
  status        UserStatus @default(ACTIVE)
  lastCompanyId String?    @map("last_company_id") @db.Uuid
  lastSignInAt  DateTime?  @map("last_sign_in_at") @db.Timestamptz(6)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById   String?    @map("created_by") @db.Uuid
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById   String?    @map("updated_by") @db.Uuid
  archivedAt    DateTime?  @map("archived_at") @db.Timestamptz(6)

  identities              UserIdentity[]
  accounts                Account[]
  sessions                Session[]
  organizationMemberships OrganizationMembership[]
  companyMemberships      CompanyMembership[]

  @@map("users")
}

/// Provider-independent record of an external identity used to sign in
/// (Entra object id, dev login). Auth.js `accounts` holds OAuth tokens.
model UserIdentity {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  provider     String
  subject      String
  tenantId     String?   @map("tenant_id")
  email        String?
  lastSignInAt DateTime? @map("last_sign_in_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, subject])
  @@index([userId])
  @@map("user_identities")
}

/// Auth.js adapter table (OAuth accounts).
model Account {
  id                       String   @id @default(uuid(7)) @db.Uuid
  userId                   String   @map("user_id") @db.Uuid
  type                     String
  provider                 String
  providerAccountId        String   @map("provider_account_id")
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  /// Microsoft Entra returns these in its token response.
  ext_expires_in           Int?
  refresh_token_expires_in Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/// Auth.js adapter table (database sessions).
model Session {
  id           String   @id @default(uuid(7)) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model OrganizationMembership {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole @default(MEMBER)
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById    String?          @map("created_by") @db.Uuid
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById    String?          @map("updated_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_memberships")
}

model CompanyMembership {
  id          String           @id @default(uuid(7)) @db.Uuid
  companyId   String           @map("company_id") @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  status      MembershipStatus @default(INVITED)
  invitedAt   DateTime?        @map("invited_at") @db.Timestamptz(6)
  invitedById String?          @map("invited_by") @db.Uuid
  acceptedAt  DateTime?        @map("accepted_at") @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?          @map("created_by") @db.Uuid
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById String?          @map("updated_by") @db.Uuid

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  roles              MembershipRole[]
  projectMemberships ProjectMembership[]

  @@unique([companyId, id])
  @@unique([companyId, userId])
  @@index([userId])
  @@map("company_memberships")
}

/// Company-scoped role, instantiated from a system template (templateKey)
/// or created by the company. Code checks permissions, never role names.
model Role {
  id            String        @id @default(uuid(7)) @db.Uuid
  companyId     String        @map("company_id") @db.Uuid
  key           String
  templateKey   String?       @map("template_key")
  name          String
  description   String?
  projectAccess ProjectAccess @default(ASSIGNED) @map("project_access")
  isSystem      Boolean       @default(false) @map("is_system")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById   String?       @map("created_by") @db.Uuid
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById   String?       @map("updated_by") @db.Uuid
  archivedAt    DateTime?     @map("archived_at") @db.Timestamptz(6)

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  permissions        RolePermission[]
  membershipRoles    MembershipRole[]
  projectMemberships ProjectMembership[]

  @@unique([companyId, id])
  @@unique([companyId, key])
  @@map("roles")
}

/// Global permission catalogue (capabilities).
model Permission {
  key         String  @id
  category    String
  description String
  isSensitive Boolean @default(false) @map("is_sensitive")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  companyId     String   @map("company_id") @db.Uuid
  roleId        String   @map("role_id") @db.Uuid
  permissionKey String   @map("permission_key")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById   String?  @map("created_by") @db.Uuid

  role       Role       @relation(fields: [companyId, roleId], references: [companyId, id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Restrict)

  @@id([roleId, permissionKey])
  @@index([companyId])
  @@map("role_permissions")
}

model MembershipRole {
  companyId    String   @map("company_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById  String?  @map("created_by") @db.Uuid

  membership CompanyMembership @relation(fields: [companyId, membershipId], references: [companyId, id], onDelete: Cascade)
  role       Role              @relation(fields: [companyId, roleId], references: [companyId, id], onDelete: Restrict)

  @@id([membershipId, roleId])
  @@index([companyId])
  @@map("membership_roles")
}

/// Assigns a company member to a project with a project-level role.
/// Effective permissions inside the project = company roles ∪ project role.
model ProjectMembership {
  id          String    @id @default(uuid(7)) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  roleId      String    @map("role_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById String?   @map("updated_by") @db.Uuid
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(6)

  project    Project           @relation(fields: [companyId, projectId], references: [companyId, id], onDelete: Restrict)
  membership CompanyMembership @relation(fields: [companyId, userId], references: [companyId, userId], onDelete: Restrict)
  role       Role              @relation(fields: [companyId, roleId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, id])
  @@unique([projectId, userId])
  @@index([companyId, userId])
  @@map("project_memberships")
}

// ─────────────────────────────────────────────────────────────── Projects
// Hierarchy: Company → Project → Site → (V3: Building/Area → Takt Area →
// Work Package → Activity). Sites expose @@unique([companyId, projectId, id])
// so future child tables can reference (company_id, project_id, site_id).

model Project {
  id           String        @id @default(uuid(7)) @db.Uuid
  companyId    String        @map("company_id") @db.Uuid
  code         String
  name         String
  customerName String?       @map("customer_name")
  description  String?
  status       ProjectStatus @default(PLANNED)
  startDate    DateTime?     @map("start_date") @db.Date
  endDate      DateTime?     @map("end_date") @db.Date
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById  String?       @map("created_by") @db.Uuid
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById  String?       @map("updated_by") @db.Uuid
  archivedAt   DateTime?     @map("archived_at") @db.Timestamptz(6)

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sites       Site[]
  memberships ProjectMembership[]
  equipment   Equipment[]
  documents   Document[]

  @@unique([companyId, id])
  @@unique([companyId, code])
  @@index([companyId, archivedAt])
  @@map("projects")
}

model Site {
  id          String     @id @default(uuid(7)) @db.Uuid
  companyId   String     @map("company_id") @db.Uuid
  projectId   String     @map("project_id") @db.Uuid
  code        String?
  name        String
  address     String?
  postalCode  String?    @map("postal_code")
  city        String?
  latitude    Decimal?   @db.Decimal(9, 6)
  longitude   Decimal?   @db.Decimal(9, 6)
  status      SiteStatus @default(ACTIVE)
  notes       String?
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?    @map("created_by") @db.Uuid
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById String?    @map("updated_by") @db.Uuid
  archivedAt  DateTime?  @map("archived_at") @db.Timestamptz(6)

  company   Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project   Project     @relation(fields: [companyId, projectId], references: [companyId, id], onDelete: Restrict)
  equipment Equipment[]
  documents Document[]

  @@unique([companyId, id])
  @@unique([companyId, projectId, id])
  @@index([companyId, projectId])
  @@map("sites")
}

// ─────────────────────────────────────────────────────────────── Workforce
// Employees are future bookable resources (V4): stable id, owning company,
// status. Cross-company use will be a booking, never a change of company_id.

model Employee {
  id             String         @id @default(uuid(7)) @db.Uuid
  companyId      String         @map("company_id") @db.Uuid
  employeeNumber String         @map("employee_number")
  firstName      String         @map("first_name")
  lastName       String         @map("last_name")
  email          String?
  phone          String?
  jobTitle       String?        @map("job_title")
  trade          String?
  employmentType EmploymentType @default(EMPLOYEE) @map("employment_type")
  status         ResourceStatus @default(ACTIVE)
  userId         String?        @map("user_id") @db.Uuid
  startDate      DateTime?      @map("start_date") @db.Date
  endDate        DateTime?      @map("end_date") @db.Date
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById    String?        @map("created_by") @db.Uuid
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById    String?        @map("updated_by") @db.Uuid
  archivedAt     DateTime?      @map("archived_at") @db.Timestamptz(6)

  company Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  rates   EmployeeRate[]

  @@unique([companyId, id])
  @@unique([companyId, employeeNumber])
  @@index([companyId, archivedAt])
  @@map("employees")
}

/// Sensitive: readable only with `employee.rates.view`.
model EmployeeRate {
  id          String    @id @default(uuid(7)) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  employeeId  String    @map("employee_id") @db.Uuid
  rateType    RateType  @map("rate_type")
  unit        RateUnit  @default(HOUR)
  amount      Decimal   @db.Decimal(14, 2)
  currency    String    @default("EUR") @db.Char(3)
  validFrom   DateTime  @map("valid_from") @db.Date
  validTo     DateTime? @map("valid_to") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById String?   @map("updated_by") @db.Uuid
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(6)

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, id])
  @@index([companyId, employeeId, rateType, validFrom])
  @@map("employee_rates")
}

// ─────────────────────────────────────────────────────────────── Equipment

model EquipmentType {
  id          String            @id @default(uuid(7)) @db.Uuid
  companyId   String            @map("company_id") @db.Uuid
  name        String
  category    EquipmentCategory @default(OTHER)
  description String?
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?           @map("created_by") @db.Uuid
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById String?           @map("updated_by") @db.Uuid
  archivedAt  DateTime?         @map("archived_at") @db.Timestamptz(6)

  company   Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  equipment Equipment[]

  @@unique([companyId, id])
  @@unique([companyId, name])
  @@map("equipment_types")
}

/// Owned by exactly one company. Future cross-company use (V4) is a booking.
model Equipment {
  id                 String          @id @default(uuid(7)) @db.Uuid
  companyId          String          @map("company_id") @db.Uuid
  equipmentTypeId    String          @map("equipment_type_id") @db.Uuid
  assetNumber        String          @map("asset_number")
  name               String
  manufacturer       String?
  model              String?
  serialNumber       String?         @map("serial_number")
  registrationNumber String?         @map("registration_number")
  status             EquipmentStatus @default(AVAILABLE)
  currentProjectId   String?         @map("current_project_id") @db.Uuid
  currentSiteId      String?         @map("current_site_id") @db.Uuid
  meterHours         Decimal?        @map("meter_hours") @db.Decimal(10, 1)
  nextInspectionDate DateTime?       @map("next_inspection_date") @db.Date
  notes              String?
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById        String?         @map("created_by") @db.Uuid
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById        String?         @map("updated_by") @db.Uuid
  archivedAt         DateTime?       @map("archived_at") @db.Timestamptz(6)

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  equipmentType  EquipmentType   @relation(fields: [companyId, equipmentTypeId], references: [companyId, id], onDelete: Restrict)
  currentProject Project?        @relation(fields: [companyId, currentProjectId], references: [companyId, id], onDelete: Restrict)
  currentSite    Site?           @relation(fields: [companyId, currentProjectId, currentSiteId], references: [companyId, projectId, id], onDelete: Restrict)
  rates          EquipmentRate[]

  @@unique([companyId, id])
  @@unique([companyId, assetNumber])
  @@index([companyId, archivedAt])
  @@map("equipment")
}

/// Sensitive: readable only with `equipment.rates.view`.
model EquipmentRate {
  id          String    @id @default(uuid(7)) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  equipmentId String    @map("equipment_id") @db.Uuid
  rateType    RateType  @map("rate_type")
  unit        RateUnit  @default(HOUR)
  amount      Decimal   @db.Decimal(14, 2)
  currency    String    @default("EUR") @db.Char(3)
  validFrom   DateTime  @map("valid_from") @db.Date
  validTo     DateTime? @map("valid_to") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById String?   @map("updated_by") @db.Uuid
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(6)

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  equipment Equipment @relation(fields: [companyId, equipmentId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, id])
  @@index([companyId, equipmentId, rateType, validFrom])
  @@map("equipment_rates")
}

// ─────────────────────────────────────────────────────────────── Documents

model Document {
  id             String           @id @default(uuid(7)) @db.Uuid
  companyId      String           @map("company_id") @db.Uuid
  projectId      String?          @map("project_id") @db.Uuid
  siteId         String?          @map("site_id") @db.Uuid
  title          String
  documentNumber String?          @map("document_number")
  category       DocumentCategory @default(OTHER)
  description    String?
  ownerUserId    String?          @map("owner_user_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById    String?          @map("created_by") @db.Uuid
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById    String?          @map("updated_by") @db.Uuid
  archivedAt     DateTime?        @map("archived_at") @db.Timestamptz(6)

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project  Project?          @relation(fields: [companyId, projectId], references: [companyId, id], onDelete: Restrict)
  site     Site?             @relation(fields: [companyId, projectId, siteId], references: [companyId, projectId, id], onDelete: Restrict)
  versions DocumentVersion[]
  links    DocumentLink[]

  @@unique([companyId, id])
  @@index([companyId, projectId])
  @@index([companyId, archivedAt])
  @@map("documents")
}

/// Versions are never overwritten: a trigger blocks changes to content
/// columns; only status/approval columns may change.
model DocumentVersion {
  id            String                @id @default(uuid(7)) @db.Uuid
  companyId     String                @map("company_id") @db.Uuid
  documentId    String                @map("document_id") @db.Uuid
  versionNumber Int                   @map("version_number")
  revisionLabel String?               @map("revision_label")
  fileName      String                @map("file_name")
  contentType   String                @map("content_type")
  sizeBytes     BigInt                @map("size_bytes")
  sha256        String                @db.Char(64)
  storageKey    String                @map("storage_key")
  status        DocumentVersionStatus @default(CURRENT)
  approvalState ApprovalState         @default(DRAFT) @map("approval_state")
  approvedById  String?               @map("approved_by") @db.Uuid
  approvedAt    DateTime?             @map("approved_at") @db.Timestamptz(6)
  issueDate     DateTime?             @map("issue_date") @db.Date
  changeNote    String?               @map("change_note")
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById   String?               @map("created_by") @db.Uuid
  updatedAt     DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById   String?               @map("updated_by") @db.Uuid

  document Document @relation(fields: [companyId, documentId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, id])
  @@unique([documentId, versionNumber])
  @@map("document_versions")
}

/// Polymorphic link from a document to another company-scoped entity.
/// The target's company is validated by the documents service.
model DocumentLink {
  id          String             @id @default(uuid(7)) @db.Uuid
  companyId   String             @map("company_id") @db.Uuid
  documentId  String             @map("document_id") @db.Uuid
  entityType  DocumentLinkEntity @map("entity_type")
  entityId    String             @map("entity_id") @db.Uuid
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?            @map("created_by") @db.Uuid
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById String?            @map("updated_by") @db.Uuid
  archivedAt  DateTime?          @map("archived_at") @db.Timestamptz(6)

  document Document @relation(fields: [companyId, documentId], references: [companyId, id], onDelete: Restrict)

  @@unique([documentId, entityType, entityId])
  @@index([companyId, entityType, entityId])
  @@map("document_links")
}

// ─────────────────────────────────────────────────────────────── System

/// Append-only. A trigger rejects UPDATE and DELETE. Written in the same
/// transaction as the change it describes. Sensitive values are masked.
model AuditEvent {
  id             String    @id @default(uuid(7)) @db.Uuid
  occurredAt     DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  organizationId String?   @map("organization_id") @db.Uuid
  companyId      String?   @map("company_id") @db.Uuid
  projectId      String?   @map("project_id") @db.Uuid
  actorType      ActorType @default(USER) @map("actor_type")
  actorUserId    String?   @map("actor_user_id") @db.Uuid
  action         String
  entityType     String    @map("entity_type")
  entityId       String?   @map("entity_id") @db.Uuid
  before         Json?
  after          Json?
  metadata       Json?

  @@index([companyId, occurredAt])
  @@index([companyId, entityType, entityId])
  @@index([actorUserId, occurredAt])
  @@map("audit_events")
}
