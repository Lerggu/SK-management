/// A billable line from approved data. At most one non-void candidate per
/// source (partial unique index), so nothing is billed twice. INTERNAL_BOOKING candidates are billed by the
/// owning company to the booking company (owner decision 2).
model InvoiceCandidate {
  id               String                 @id @default(uuid(7)) @db.Uuid
  companyId        String                 @map("company_id") @db.Uuid
  projectId        String?                @map("project_id") @db.Uuid
  customerId       String?                @map("customer_id") @db.Uuid
  billToCompanyId  String?                @map("bill_to_company_id") @db.Uuid
  sourceType       InvoiceSourceType      @map("source_type")
  sourceId         String                 @map("source_id") @db.Uuid
  description      String
  quantity         Decimal                @db.Decimal(12, 2)
  unit             String
  unitPrice        Decimal                @map("unit_price") @db.Decimal(14, 2)
  amount           Decimal                @db.Decimal(14, 2)
  currency         String                 @default("EUR") @db.Char(3)
  periodDate       DateTime               @map("period_date") @db.Date
  status           InvoiceCandidateStatus @default(OPEN)
  exportBatchId    String?                @map("export_batch_id") @db.Uuid
  invoicedAt       DateTime?              @map("invoiced_at") @db.Timestamptz(6)
  invoicedById     String?                @map("invoiced_by") @db.Uuid
  invoiceReference String?                @map("invoice_reference")
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById      String?                @map("created_by") @db.Uuid
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById      String?                @map("updated_by") @db.Uuid

  company       Company             @relation("CandidateCompany", fields: [companyId], references: [id], onDelete: Restrict)
  billToCompany Company?            @relation("CandidateBillTo", fields: [billToCompanyId], references: [id], onDelete: Restrict)
  project       Project?            @relation(fields: [companyId, projectId], references: [companyId, id], onDelete: Restrict)
  customer      Customer?           @relation(fields: [companyId, customerId], references: [companyId, id], onDelete: Restrict)
  exportBatch   InvoiceExportBatch? @relation(fields: [companyId, exportBatchId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, id])
  @@index([companyId, sourceType, sourceId])
  @@index([companyId, status, periodDate])
  @@map("invoice_candidates")
}

