  @@unique([companyId, id])
  @@unique([siteId, reportDate])
  @@index([companyId, projectId, reportDate])
  @@map("daily_reports")
}

model DailyReportEntry {
  id            String               @id @default(uuid(7)) @db.Uuid
  companyId     String               @map("company_id") @db.Uuid
  dailyReportId String               @map("daily_report_id") @db.Uuid
  kind          DailyReportEntryKind
  description   String?
  equipmentId   String?              @map("equipment_id") @db.Uuid
  hours         Decimal?             @db.Decimal(6, 2)
  /// Added after signing (audited addendum).
  isAddendum    Boolean              @default(false) @map("is_addendum")
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById   String?              @map("created_by") @db.Uuid

  dailyReport DailyReport @relation(fields: [companyId, dailyReportId], references: [companyId, id], onDelete: Restrict)
  equipment   Equipment?  @relation(fields: [companyId, equipmentId], references: [companyId, id], onDelete: Restrict)

  @@index([companyId, dailyReportId])
  @@index([companyId, equipmentId])
  @@map("daily_report_entries")
}

model DailyReportAttachment {
  id            String   @id @default(uuid(7)) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  dailyReportId String   @map("daily_report_id") @db.Uuid
  fileName      String   @map("file_name")
  contentType   String   @map("content_type")
  sizeBytes     BigInt   @map("size_bytes")
  sha256        String   @db.Char(64)
  storageKey    String   @map("storage_key")
  caption       String?
  isAddendum    Boolean  @default(false) @map("is_addendum")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById   String?  @map("created_by") @db.Uuid

  dailyReport DailyReport @relation(fields: [companyId, dailyReportId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, id])
  @@index([companyId, dailyReportId])
  @@map("daily_report_attachments")
}

enum CostCategory {
  LABOR
  EQUIPMENT
  MATERIALS
  SUBCONTRACT
  OTHER
}

enum BudgetStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
}

/// Budget version per project. Version 1 is the original budget. Lines are
/// editable only in DRAFT; activating a version supersedes the previous one.
model Budget {
  id            String       @id @default(uuid(7)) @db.Uuid
  companyId     String       @map("company_id") @db.Uuid
  projectId     String       @map("project_id") @db.Uuid
  versionNumber Int          @map("version_number")
  status        BudgetStatus @default(DRAFT)
  currency      String       @default("EUR") @db.Char(3)
  note          String?
  activatedAt   DateTime?    @map("activated_at") @db.Timestamptz(6)
  activatedById String?      @map("activated_by") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById   String?      @map("created_by") @db.Uuid
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById   String?      @map("updated_by") @db.Uuid

  company Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project Project      @relation(fields: [companyId, projectId], references: [companyId, id], onDelete: Restrict)
  lines   BudgetLine[]

  @@unique([companyId, id])
  @@unique([projectId, versionNumber])
  @@map("budgets")
}

model BudgetLine {
  id          String       @id @default(uuid(7)) @db.Uuid
  companyId   String       @map("company_id") @db.Uuid
  budgetId    String       @map("budget_id") @db.Uuid
  category    CostCategory
  description String
  amount      Decimal      @db.Decimal(14, 2)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?      @map("created_by") @db.Uuid
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById String?      @map("updated_by") @db.Uuid

  budget Budget @relation(fields: [companyId, budgetId], references: [companyId, id], onDelete: Cascade)

  @@unique([companyId, id])
  @@index([companyId, budgetId])
  @@map("budget_lines")
}

/// Manually recorded project cost (materials, subcontracting, rentals…).
/// Labour and diary equipment costs are computed, not entered here.
model CostEntry {
  id          String       @id @default(uuid(7)) @db.Uuid
  companyId   String       @map("company_id") @db.Uuid
  projectId   String       @map("project_id") @db.Uuid
  siteId      String?      @map("site_id") @db.Uuid
  category    CostCategory
  entryDate   DateTime     @map("entry_date") @db.Date
  description String
  supplier    String?
  reference   String?
  amount      Decimal      @db.Decimal(14, 2)
  currency    String       @default("EUR") @db.Char(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?      @map("created_by") @db.Uuid
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById String?      @map("updated_by") @db.Uuid
  archivedAt  DateTime?    @map("archived_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project Project @relation(fields: [companyId, projectId], references: [companyId, id], onDelete: Restrict)
  site    Site?   @relation(fields: [companyId, projectId, siteId], references: [companyId, projectId, id], onDelete: Restrict)

  @@unique([companyId, id])
  @@index([companyId, projectId, entryDate])
  @@map("cost_entries")
}

// ─────────────────────────────────────────────────────────────── V3 — Takt
// Hierarchy: Site → Building/Area → Takt Area; Work Packages are project-level
// trades ("wagons"); an Activity is one work package in one takt area of a
// site plan. Planned dates live in versioned assignments (DRAFT → PROPOSED →
// BASELINE → SUPERSEDED); a baseline is frozen by DB triggers. Actual dates,
// progress and constraints are facts on the activity and are not versioned.
// See docs/adr/0012-takt-plan-versioning.md.

/// Company working calendar: working weekdays (ISO 1 = Monday … 7 = Sunday)
/// and public holidays. Day-takt cycles skip non-working days.
model WorkCalendar {
  id              String    @id @default(uuid(7)) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  name            String
  workingWeekdays Int[]     @default([1, 2, 3, 4, 5]) @map("working_weekdays")
  isDefault       Boolean   @default(false) @map("is_default")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById     String?   @map("created_by") @db.Uuid
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById     String?   @map("updated_by") @db.Uuid
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(6)

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  holidays CalendarHoliday[]
  plans    TaktPlan[]

  @@unique([companyId, id])
  @@unique([companyId, name])
  @@map("work_calendars")
}

model CalendarHoliday {
  id          String   @id @default(uuid(7)) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  calendarId  String   @map("calendar_id") @db.Uuid
  date        DateTime @db.Date
  name        String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?  @map("created_by") @db.Uuid

  calendar WorkCalendar @relation(fields: [companyId, calendarId], references: [companyId, id], onDelete: Cascade)

  @@unique([companyId, id])
  @@unique([calendarId, date])
  @@map("calendar_holidays")
}

enum BuildingKind {
  BUILDING
  AREA
}

model Building {
  id          String       @id @default(uuid(7)) @db.Uuid
  companyId   String       @map("company_id") @db.Uuid
  projectId   String       @map("project_id") @db.Uuid
  siteId      String       @map("site_id") @db.Uuid
  code        String?
  name        String
  kind        BuildingKind @default(BUILDING)
  sortOrder   Int          @default(0) @map("sort_order")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?      @map("created_by") @db.Uuid
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById String?      @map("updated_by") @db.Uuid
  archivedAt  DateTime?    @map("archived_at") @db.Timestamptz(6)

  site      Site       @relation(fields: [companyId, projectId, siteId], references: [companyId, projectId, id], onDelete: Restrict)
  taktAreas TaktArea[]

  @@unique([companyId, id])
  @@unique([companyId, siteId, id])
  @@unique([siteId, name])
  @@map("buildings")
}

model TaktArea {
  id          String    @id @default(uuid(7)) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  siteId      String    @map("site_id") @db.Uuid
  buildingId  String    @map("building_id") @db.Uuid
  code        String
  name        String
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById String?   @map("updated_by") @db.Uuid
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(6)

  building   Building       @relation(fields: [companyId, siteId, buildingId], references: [companyId, siteId, id], onDelete: Restrict)
  activities TaktActivity[]

  @@unique([companyId, id])
  @@unique([companyId, siteId, id])
  @@unique([buildingId, code])
  @@map("takt_areas")
}

/// A trade "wagon" of the takt train, reusable across the project's sites.
model WorkPackage {
  id                    String    @id @default(uuid(7)) @db.Uuid
  companyId             String    @map("company_id") @db.Uuid
  projectId             String    @map("project_id") @db.Uuid
  code                  String
  name                  String
  trade                 String?
  color                 String    @default("#1E88A8")
  defaultCrewSize       Int       @default(2) @map("default_crew_size")
  defaultDurationCycles Int       @default(1) @map("default_duration_cycles")
  equipmentTypeId       String?   @map("equipment_type_id") @db.Uuid
  equipmentCount        Int       @default(0) @map("equipment_count")
  sortOrder             Int       @default(0) @map("sort_order")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById           String?   @map("created_by") @db.Uuid
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById           String?   @map("updated_by") @db.Uuid
  archivedAt            DateTime? @map("archived_at") @db.Timestamptz(6)

  project       Project        @relation(fields: [companyId, projectId], references: [companyId, id], onDelete: Restrict)
  equipmentType EquipmentType? @relation(fields: [companyId, equipmentTypeId], references: [companyId, id], onDelete: Restrict)
  activities    TaktActivity[]

  @@unique([companyId, id])
  @@unique([companyId, projectId, id])
  @@unique([projectId, code])
  @@map("work_packages")
}

/// One takt plan per site (or several named alternatives).
model TaktPlan {
  id              String    @id @default(uuid(7)) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  projectId       String    @map("project_id") @db.Uuid
  siteId          String    @map("site_id") @db.Uuid
  calendarId      String    @map("calendar_id") @db.Uuid
  name            String
  cycleLengthDays Int       @default(1) @map("cycle_length_days")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById     String?   @map("created_by") @db.Uuid
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById     String?   @map("updated_by") @db.Uuid
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(6)

  site       Site              @relation(fields: [companyId, projectId, siteId], references: [companyId, projectId, id], onDelete: Restrict)
  calendar   WorkCalendar      @relation(fields: [companyId, calendarId], references: [companyId, id], onDelete: Restrict)
  versions   TaktPlanVersion[]
  activities TaktActivity[]
  imports    ScheduleImport[]

  @@unique([companyId, id])
  @@unique([companyId, projectId, siteId, id])
  @@unique([siteId, name])
  @@map("takt_plans")
}

enum TaktPlanVersionStatus {
  DRAFT
  PROPOSED
  BASELINE
  SUPERSEDED
}

/// Plan version. Only DRAFT versions are editable; at most one DRAFT/PROPOSED
/// and one BASELINE per plan (partial unique indexes). BASELINE/SUPERSEDED
/// versions are frozen by a DB trigger.
model TaktPlanVersion {
  id            String                @id @default(uuid(7)) @db.Uuid
  companyId     String                @map("company_id") @db.Uuid
  planId        String                @map("plan_id") @db.Uuid
  versionNumber Int                   @map("version_number")
  status        TaktPlanVersionStatus @default(DRAFT)
  startDate     DateTime              @map("start_date") @db.Date
  reason        String?
  basedOnId     String?               @map("based_on_id") @db.Uuid
  proposedAt    DateTime?             @map("proposed_at") @db.Timestamptz(6)
  proposedById  String?               @map("proposed_by") @db.Uuid
  approvedAt    DateTime?             @map("approved_at") @db.Timestamptz(6)
  approvedById  String?               @map("approved_by") @db.Uuid
  supersededAt  DateTime?             @map("superseded_at") @db.Timestamptz(6)
  returnedNote  String?               @map("returned_note")
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById   String?               @map("created_by") @db.Uuid
  updatedAt     DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById   String?               @map("updated_by") @db.Uuid

  plan         TaktPlan              @relation(fields: [companyId, planId], references: [companyId, id], onDelete: Restrict)
  assignments  TaktAssignment[]
  requirements ResourceRequirement[]

  @@unique([companyId, id])
  @@unique([companyId, planId, id])
  @@unique([planId, versionNumber])
  @@map("takt_plan_versions")
}

enum ActivityExecution {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
}

/// Work package × takt area within a plan. Requirements (crew, equipment)
/// default from the work package. Actuals and progress are not versioned.
model TaktActivity {
  id              String            @id @default(uuid(7)) @db.Uuid
  companyId       String            @map("company_id") @db.Uuid
  projectId       String            @map("project_id") @db.Uuid
  siteId          String            @map("site_id") @db.Uuid
  planId          String            @map("plan_id") @db.Uuid
  taktAreaId      String            @map("takt_area_id") @db.Uuid
  workPackageId   String            @map("work_package_id") @db.Uuid
  name            String
  crewTrade       String?           @map("crew_trade")
  crewSize        Int               @default(0) @map("crew_size")
  equipmentTypeId String?           @map("equipment_type_id") @db.Uuid
  equipmentCount  Int               @default(0) @map("equipment_count")
  execution       ActivityExecution @default(NOT_STARTED)
  progressPct     Int               @default(0) @map("progress_pct")
  actualStart     DateTime?         @map("actual_start") @db.Date
  actualEnd       DateTime?         @map("actual_end") @db.Date
  blocked         Boolean           @default(false)
  delayReason     String?           @map("delay_reason")
  recoveryAction  String?           @map("recovery_action")
  externalRef     String?           @map("external_ref")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById     String?           @map("created_by") @db.Uuid
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById     String?           @map("updated_by") @db.Uuid
  archivedAt      DateTime?         @map("archived_at") @db.Timestamptz(6)

  plan              TaktPlan              @relation(fields: [companyId, projectId, siteId, planId], references: [companyId, projectId, siteId, id], onDelete: Restrict)
  taktArea          TaktArea              @relation(fields: [companyId, siteId, taktAreaId], references: [companyId, siteId, id], onDelete: Restrict)
  workPackage       WorkPackage           @relation(fields: [companyId, projectId, workPackageId], references: [companyId, projectId, id], onDelete: Restrict)
  equipmentType     EquipmentType?        @relation(fields: [companyId, equipmentTypeId], references: [companyId, id], onDelete: Restrict)
  assignments       TaktAssignment[]
  predecessors      ActivityDependency[]  @relation("DependencySuccessor")
  successors        ActivityDependency[]  @relation("DependencyPredecessor")
  constraints       ActivityConstraint[]
  progress          ActivityProgress[]
  requirements      ResourceRequirement[]
  bookings          ResourceBooking[]
  logisticsRequests LogisticsRequest[]
  deliveries        Delivery[]
  liftPlans         LiftPlan[]
  materialBatches   MaterialBatch[]
  materialMovements MaterialMovement[]
  reservedDrums     CableDrum[]
  cablePulls        CablePull[]

  @@unique([companyId, id])
  @@unique([companyId, planId, id])
  @@unique([companyId, siteId, id])
  @@unique([planId, workPackageId, taktAreaId])
  @@index([companyId, planId])
  @@map("takt_activities")
}

/// Planned position of an activity in one plan version (cycle index from the
/// version start date, counted in working days × cycle length).
model TaktAssignment {
  id             String   @id @default(uuid(7)) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  planId         String   @map("plan_id") @db.Uuid
  versionId      String   @map("version_id") @db.Uuid
  activityId     String   @map("activity_id") @db.Uuid
  startCycle     Int      @map("start_cycle")
  durationCycles Int      @default(1) @map("duration_cycles")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  version  TaktPlanVersion @relation(fields: [companyId, planId, versionId], references: [companyId, planId, id], onDelete: Cascade)
  activity TaktActivity    @relation(fields: [companyId, planId, activityId], references: [companyId, planId, id], onDelete: Restrict)

  @@unique([companyId, id])
  @@unique([versionId, activityId])
  @@map("takt_assignments")
}

enum DependencyType {
  FS
  SS
  FF
  SF
}

model ActivityDependency {
  id            String         @id @default(uuid(7)) @db.Uuid
  companyId     String         @map("company_id") @db.Uuid
  planId        String         @map("plan_id") @db.Uuid
  predecessorId String         @map("predecessor_id") @db.Uuid
  successorId   String         @map("successor_id") @db.Uuid
  type          DependencyType @default(FS)
  lagDays       Int            @default(0) @map("lag_days")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById   String?        @map("created_by") @db.Uuid

  predecessor TaktActivity @relation("DependencyPredecessor", fields: [companyId, planId, predecessorId], references: [companyId, planId, id], onDelete: Restrict)
  successor   TaktActivity @relation("DependencySuccessor", fields: [companyId, planId, successorId], references: [companyId, planId, id], onDelete: Restrict)

  @@unique([companyId, id])
  @@unique([predecessorId, successorId])
  @@index([companyId, planId])
  @@map("activity_dependencies")
}

enum ConstraintType {
  DRAWINGS
  MATERIAL
  WORKFORCE
  EQUIPMENT
  PERMIT
  AREA
  OTHER
}

enum ConstraintStatus {
  OPEN
  CLEARED
}

/// Readiness constraint. The predecessor check is derived from dependencies.
model ActivityConstraint {
  id          String           @id @default(uuid(7)) @db.Uuid
  companyId   String           @map("company_id") @db.Uuid
  planId      String           @map("plan_id") @db.Uuid
  activityId  String           @map("activity_id") @db.Uuid
  type        ConstraintType
  description String
  dueDate     DateTime?        @map("due_date") @db.Date
  status      ConstraintStatus @default(OPEN)
  clearedAt   DateTime?        @map("cleared_at") @db.Timestamptz(6)
  clearedById String?          @map("cleared_by") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?          @map("created_by") @db.Uuid
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById String?          @map("updated_by") @db.Uuid

  activity   TaktActivity @relation(fields: [companyId, planId, activityId], references: [companyId, planId, id], onDelete: Restrict)
  deliveries Delivery[]

  @@unique([companyId, id])
  @@index([companyId, planId, status])
  @@map("activity_constraints")
}

/// Append-only progress history (DB trigger blocks UPDATE/DELETE).
model ActivityProgress {
  id          String   @id @default(uuid(7)) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  planId      String   @map("plan_id") @db.Uuid
  activityId  String   @map("activity_id") @db.Uuid
  reportDate  DateTime @map("report_date") @db.Date
  progressPct Int      @map("progress_pct")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?  @map("created_by") @db.Uuid

  activity TaktActivity @relation(fields: [companyId, planId, activityId], references: [companyId, planId, id], onDelete: Restrict)

  @@unique([companyId, id])
  @@index([companyId, planId, reportDate])
  @@map("activity_progress")
}

enum RequirementKind {
  TRADE
  EQUIPMENT_TYPE
}

/// Resource requirement generated when a version becomes the baseline; the
/// basis for V4–V5 bookings. Immutable (DB trigger).
model ResourceRequirement {
  id              String          @id @default(uuid(7)) @db.Uuid
  companyId       String          @map("company_id") @db.Uuid
  planId          String          @map("plan_id") @db.Uuid
  versionId       String          @map("version_id") @db.Uuid
  activityId      String          @map("activity_id") @db.Uuid
  kind            RequirementKind
  trade           String?
  equipmentTypeId String?         @map("equipment_type_id") @db.Uuid
  quantity        Int
  startDate       DateTime        @map("start_date") @db.Date
  endDate         DateTime        @map("end_date") @db.Date
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  version       TaktPlanVersion   @relation(fields: [companyId, planId, versionId], references: [companyId, planId, id], onDelete: Restrict)
  activity      TaktActivity      @relation(fields: [companyId, planId, activityId], references: [companyId, planId, id], onDelete: Restrict)
  equipmentType EquipmentType?    @relation(fields: [companyId, equipmentTypeId], references: [companyId, id], onDelete: Restrict)
  bookings      ResourceBooking[]

  @@unique([companyId, id])
  @@index([companyId, versionId])
  @@index([companyId, startDate, endDate])
  @@map("resource_requirements")
}

enum ScheduleImportFormat {
  MSPDI
  XER
}

enum ScheduleImportStatus {
  PREVIEW
  APPLIED
  DISCARDED
}

/// MS Project XML / Primavera P6 XER file import. The original file is kept
/// in storage (SHA-256); applying it creates a new DRAFT version.
model ScheduleImport {
  id              String               @id @default(uuid(7)) @db.Uuid
  companyId       String               @map("company_id") @db.Uuid
  planId          String               @map("plan_id") @db.Uuid
  format          ScheduleImportFormat
  fileName        String               @map("file_name")
  sizeBytes       BigInt               @map("size_bytes")
  sha256          String               @db.Char(64)
  storageKey      String               @map("storage_key")
  status          ScheduleImportStatus @default(PREVIEW)
  options         Json
  preview         Json
  resultVersionId String?              @map("result_version_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById     String?              @map("created_by") @db.Uuid
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById     String?              @map("updated_by") @db.Uuid

  plan TaktPlan @relation(fields: [companyId, planId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, id])
  @@index([companyId, planId])
  @@map("schedule_imports")
}

// ─────────────────────────────────────────────────────────────── V4 — Logistics
// Bookings are the only way a resource is used by another company: the
// resource keeps its owning company (owner_company_id); the booking belongs
// to the booking company (company_id). Both must be in the same organization
// (DB trigger). See docs/adr/0014-resource-bookings.md.

enum BookingResourceKind {
  EMPLOYEE
  EQUIPMENT
}

enum BookingStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

model ResourceBooking {
  id                String              @id @default(uuid(7)) @db.Uuid
  companyId         String              @map("company_id") @db.Uuid
  ownerCompanyId    String              @map("owner_company_id") @db.Uuid
  resourceKind      BookingResourceKind @map("resource_kind")
  employeeId        String?             @map("employee_id") @db.Uuid
  equipmentId       String?             @map("equipment_id") @db.Uuid
  projectId         String              @map("project_id") @db.Uuid
  siteId            String?             @map("site_id") @db.Uuid
  activityId        String?             @map("activity_id") @db.Uuid
  requirementId     String?             @map("requirement_id") @db.Uuid
  /// V5: crew (riggers, crane operators) booked for a lift plan.
  liftPlanId        String?             @map("lift_plan_id") @db.Uuid
  startsAt          DateTime            @map("starts_at") @db.Timestamptz(6)
  endsAt            DateTime            @map("ends_at") @db.Timestamptz(6)
  status            BookingStatus       @default(REQUESTED)
  note              String?
  conflictsAccepted Boolean             @default(false) @map("conflicts_accepted")
  requestedById     String?             @map("requested_by") @db.Uuid
  decidedAt         DateTime?           @map("decided_at") @db.Timestamptz(6)
  decidedById       String?             @map("decided_by") @db.Uuid
  decisionNote      String?             @map("decision_note")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById       String?             @map("created_by") @db.Uuid
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById       String?             @map("updated_by") @db.Uuid

  company      Company              @relation("BookingCompany", fields: [companyId], references: [id], onDelete: Restrict)
  ownerCompany Company              @relation("BookingOwner", fields: [ownerCompanyId], references: [id], onDelete: Restrict)
  employee     Employee?            @relation(fields: [ownerCompanyId, employeeId], references: [companyId, id], onDelete: Restrict)
  equipment    Equipment?           @relation(fields: [ownerCompanyId, equipmentId], references: [companyId, id], onDelete: Restrict)
  project      Project              @relation(fields: [companyId, projectId], references: [companyId, id], onDelete: Restrict)
  site         Site?                @relation(fields: [companyId, projectId, siteId], references: [companyId, projectId, id], onDelete: Restrict)
  activity     TaktActivity?        @relation(fields: [companyId, activityId], references: [companyId, id], onDelete: Restrict)
  requirement  ResourceRequirement? @relation(fields: [companyId, requirementId], references: [companyId, id], onDelete: Restrict)
  liftPlan     LiftPlan?            @relation(fields: [companyId, liftPlanId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, id])
  @@index([companyId, projectId, startsAt])
  @@index([ownerCompanyId, startsAt])
  @@index([employeeId, startsAt])
  @@index([equipmentId, startsAt])
  @@map("resource_bookings")
}

enum LogisticsLocationKind {
  GATE
  UNLOADING
  STORAGE
}

/// Site gate (with opening hours, 30-minute delivery slots), unloading point
/// or storage location.
model LogisticsLocation {
  id           String                @id @default(uuid(7)) @db.Uuid
  companyId    String                @map("company_id") @db.Uuid
  projectId    String                @map("project_id") @db.Uuid
  siteId       String                @map("site_id") @db.Uuid
  kind         LogisticsLocationKind
  name         String
  opensMinute  Int?                  @map("opens_minute")
  closesMinute Int?                  @map("closes_minute")
  notes        String?
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById  String?               @map("created_by") @db.Uuid
  updatedAt    DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById  String?               @map("updated_by") @db.Uuid
  archivedAt   DateTime?             @map("archived_at") @db.Timestamptz(6)

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  site              Site               @relation(fields: [companyId, projectId, siteId], references: [companyId, projectId, id], onDelete: Restrict)
  gateDeliveries    Delivery[]         @relation("DeliveryGate")
  unloadDeliveries  Delivery[]         @relation("DeliveryUnloading")
  storedDeliveries  Delivery[]         @relation("DeliveryStorage")
  materialBatches   MaterialBatch[]
  materialMovements MaterialMovement[]
  cableDrums        CableDrum[]

  @@unique([companyId, id])
  @@unique([companyId, siteId, id])
  @@unique([siteId, kind, name])
  @@map("logistics_locations")
}

enum LogisticsServiceType {
  DELIVERY
  LIFT
  INTERNAL_MOVE
  WASTE_REMOVAL
  OTHER
}

enum LogisticsPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum LogisticsRequestStatus {
  DRAFT
  REQUESTED
  REVIEW
  APPROVED
  SCHEDULED
  IN_PROGRESS
  COMPLETE
  CANCELLED
}

model LogisticsRequest {
  id              String                 @id @default(uuid(7)) @db.Uuid
  companyId       String                 @map("company_id") @db.Uuid
  projectId       String                 @map("project_id") @db.Uuid
  siteId          String                 @map("site_id") @db.Uuid
  activityId      String?                @map("activity_id") @db.Uuid
  serviceType     LogisticsServiceType   @map("service_type")
  title           String
  requestedStart  DateTime               @map("requested_start") @db.Timestamptz(6)
  requestedEnd    DateTime               @map("requested_end") @db.Timestamptz(6)
  loadDescription String?                @map("load_description")
  weightKg        Decimal?               @map("weight_kg") @db.Decimal(10, 1)
  dimensions      String?
  pickup          String?
  destination     String?
  equipmentTypeId String?                @map("equipment_type_id") @db.Uuid
  priority        LogisticsPriority      @default(NORMAL)
  status          LogisticsRequestStatus @default(DRAFT)
  note            String?
  decisionNote    String?                @map("decision_note")
  requestedAt     DateTime?              @map("requested_at") @db.Timestamptz(6)
  requestedById   String?                @map("requested_by") @db.Uuid
  approvedAt      DateTime?              @map("approved_at") @db.Timestamptz(6)
  approvedById    String?                @map("approved_by") @db.Uuid
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById     String?                @map("created_by") @db.Uuid
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById     String?                @map("updated_by") @db.Uuid

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  site          Site           @relation(fields: [companyId, projectId, siteId], references: [companyId, projectId, id], onDelete: Restrict)
  activity      TaktActivity?  @relation(fields: [companyId, siteId, activityId], references: [companyId, siteId, id], onDelete: Restrict)
  equipmentType EquipmentType? @relation(fields: [companyId, equipmentTypeId], references: [companyId, id], onDelete: Restrict)
  deliveries    Delivery[]
  liftPlans     LiftPlan[]

  @@unique([companyId, id])
  @@unique([companyId, siteId, id])
  @@index([companyId, siteId, status, requestedStart])
  @@map("logistics_requests")
}

enum DeliveryStatus {
  PLANNED
  CONFIRMED
  ARRIVED_GATE
  CHECKED_IN
  UNLOADING
  STORED
  MOVED_TO_WORKFACE
  INSTALLED
  CANCELLED
}

/// Delivery in 30-minute gate slots (owner decision). A gate slot can hold
/// only one delivery (exclusion constraint). A delivery for a takt activity
/// opens a MATERIAL constraint that clears when the material is on site.
model Delivery {
  id           String         @id @default(uuid(7)) @db.Uuid
  companyId    String         @map("company_id") @db.Uuid
  projectId    String         @map("project_id") @db.Uuid
  siteId       String         @map("site_id") @db.Uuid
  gateId       String         @map("gate_id") @db.Uuid
  unloadingId  String?        @map("unloading_id") @db.Uuid
  storageId    String?        @map("storage_id") @db.Uuid
  requestId    String?        @map("request_id") @db.Uuid
  activityId   String?        @map("activity_id") @db.Uuid
  constraintId String?        @map("constraint_id") @db.Uuid
  supplier     String
  carrier      String?
  vehicle      String?
  material     String
  quantity     String?
  weightKg     Decimal?       @map("weight_kg") @db.Decimal(10, 1)
  slotStart    DateTime       @map("slot_start") @db.Timestamptz(6)
  slotEnd      DateTime       @map("slot_end") @db.Timestamptz(6)
  status       DeliveryStatus @default(PLANNED)
  arrivedAt    DateTime?      @map("arrived_at") @db.Timestamptz(6)
  completedAt  DateTime?      @map("completed_at") @db.Timestamptz(6)
  notes        String?
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById  String?        @map("created_by") @db.Uuid
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById  String?        @map("updated_by") @db.Uuid

  company         Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  site            Site                @relation(fields: [companyId, projectId, siteId], references: [companyId, projectId, id], onDelete: Restrict)
  gate            LogisticsLocation   @relation("DeliveryGate", fields: [companyId, siteId, gateId], references: [companyId, siteId, id], onDelete: Restrict)
  unloading       LogisticsLocation?  @relation("DeliveryUnloading", fields: [companyId, siteId, unloadingId], references: [companyId, siteId, id], onDelete: Restrict)
  storage         LogisticsLocation?  @relation("DeliveryStorage", fields: [companyId, siteId, storageId], references: [companyId, siteId, id], onDelete: Restrict)
  request         LogisticsRequest?   @relation(fields: [companyId, siteId, requestId], references: [companyId, siteId, id], onDelete: Restrict)
  activity        TaktActivity?       @relation(fields: [companyId, siteId, activityId], references: [companyId, siteId, id], onDelete: Restrict)
  constraint      ActivityConstraint? @relation(fields: [companyId, constraintId], references: [companyId, id], onDelete: Restrict)
  materialBatches MaterialBatch[]
  cableDrums      CableDrum[]

  @@unique([companyId, id])
  @@unique([companyId, siteId, id])
  @@index([companyId, siteId, slotStart])
  @@map("deliveries")
}

// ─────────────────────────────────────────────────── V5 Lifting & material flow

enum AccessoryKind {
  SLING
  CHAIN
  SHACKLE
  HOOK
  SPREADER_BEAM
  LIFTING_CLAMP
  OTHER
}

/// Lifting accessory register: unique code (QR label), working load limit and
/// next inspection date. A lift plan refuses accessories whose inspection is
/// due or whose WLL is below the load.
model LiftingAccessory {
  id                 String         @id @default(uuid(7)) @db.Uuid
  companyId          String         @map("company_id") @db.Uuid
  code               String
  name               String
  kind               AccessoryKind
  wllKg              Decimal        @map("wll_kg") @db.Decimal(10, 1)
  manufacturer       String?
  serialNumber       String?        @map("serial_number")
  nextInspectionDate DateTime?      @map("next_inspection_date") @db.Date
  status             ResourceStatus @default(ACTIVE)
  notes              String?
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById        String?        @map("created_by") @db.Uuid
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById        String?        @map("updated_by") @db.Uuid
  archivedAt         DateTime?      @map("archived_at") @db.Timestamptz(6)

  company  Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  planUses LiftPlanAccessory[]

  @@unique([companyId, id])
  @@unique([companyId, code])
  @@map("lifting_accessories")
}

enum LiftPlanStatus {
  OPEN
  COMPLETED
  CANCELLED
}

/// A lift (optionally for a V4 LIFT logistics request and a takt activity).
/// Contents live in versions; a lift can only be completed with an APPROVED
/// version.
model LiftPlan {
  id             String         @id @default(uuid(7)) @db.Uuid
  companyId      String         @map("company_id") @db.Uuid
  projectId      String         @map("project_id") @db.Uuid
  siteId         String         @map("site_id") @db.Uuid
  requestId      String?        @map("request_id") @db.Uuid
  activityId     String?        @map("activity_id") @db.Uuid
  title          String
