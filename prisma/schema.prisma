// ─────────────────────────────────────────────────────────────── V7: Portals

enum ClientApprovalDecision {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ClientApprovalChannel {
  PORTAL
  RECORDED
}

/// Frozen version of a variation sent to the client (owner decision 2).
/// Snapshot and hash are immutable; the decision is set once (DB trigger).
/// At most one PENDING row per variation (partial unique index).
model VariationClientApproval {
  id            String                 @id @default(uuid(7)) @db.Uuid
  companyId     String                 @map("company_id") @db.Uuid
  projectId     String                 @map("project_id") @db.Uuid
  variationId   String                 @map("variation_id") @db.Uuid
  snapshot      Json
  contentSha256 String                 @map("content_sha256") @db.Char(64)
  sentAt        DateTime               @default(now()) @map("sent_at") @db.Timestamptz(6)
  sentById      String?                @map("sent_by") @db.Uuid
  decision      ClientApprovalDecision @default(PENDING)
  channel       ClientApprovalChannel?
  decidedAt     DateTime?              @map("decided_at") @db.Timestamptz(6)
  decidedById   String?                @map("decided_by") @db.Uuid
  decisionNote  String?                @map("decision_note")
  decisionIp    String?                @map("decision_ip")

  variation Variation @relation(fields: [companyId, variationId], references: [companyId, id], onDelete: Restrict)
  project   Project   @relation(fields: [companyId, projectId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, id])
  @@index([companyId, projectId, decision])
  @@index([companyId, variationId])
  @@map("variation_client_approvals")
}

/// E-mail sign-in link for external users (owner decision 1). Only the
/// SHA-256 of the token is stored; single use, 15 minutes.
model EmailSignInToken {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenSha256 String    @unique @map("token_sha256") @db.Char(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdIp   String?   @map("created_ip")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("email_sign_in_tokens")
}

/// Development/test mailbox. Written only by the dev mailer, which is
/// hard-disabled in production (like the dev login).
model DevMailOutbox {
  id        String   @id @default(uuid(7)) @db.Uuid
  to        String
  subject   String
  bodyText  String   @map("body_text")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([to, createdAt])
  @@map("dev_mail_outbox")
}

// ─── V8: AI Project Controller (Build Master §26, ADR 0023) ─────────────

enum AiRunKind {
  REVIEW
  QUESTION
}

enum AiRunStatus {
  SUCCEEDED
  FAILED
  BLOCKED_BUDGET
}

enum AiSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AiRecommendationStatus {
  PROPOSED
  ACCEPTED
  DISMISSED
}

/// One AI run (§26: user, scope, provider/model, prompt version, tool calls,
/// structured result, cost). Append-only (database trigger).
/// Cost is a usage metric with 6 decimals so sub-cent runs add up exactly
/// against the monthly cap; it is not an accounting amount.
model AiRun {
  id               String      @id @default(uuid(7)) @db.Uuid
  companyId        String      @map("company_id") @db.Uuid
  projectId        String      @map("project_id") @db.Uuid
  requestedById    String      @map("requested_by") @db.Uuid
  kind             AiRunKind
  question         String?
  locale           String
  provider         String
  model            String
  promptVersion    String      @map("prompt_version")
  toolCalls        Json        @default("[]") @map("tool_calls")
  result           Json?
  inputTokens      Int         @default(0) @map("input_tokens")
  outputTokens     Int         @default(0) @map("output_tokens")
  cacheReadTokens  Int         @default(0) @map("cache_read_tokens")
  cacheWriteTokens Int         @default(0) @map("cache_write_tokens")
  costEur          Decimal     @default(0) @map("cost_eur") @db.Decimal(14, 6)
  currency         String      @default("EUR") @db.Char(3)
  status           AiRunStatus
  error            String?
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  company         Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project         Project            @relation(fields: [companyId, projectId], references: [companyId, id], onDelete: Restrict)
  recommendations AiRecommendation[]

  @@unique([companyId, id])
  @@index([companyId, createdAt])
  @@index([companyId, projectId, createdAt])
  @@map("ai_runs")
}

/// An AI_RECOMMENDATION item of a run's answer (facts and forecasts stay in
/// the run's result). Recommendations need a human decision
/// (accept or dismiss, once); AI never changes operational data itself.
model AiRecommendation {
  id           String                 @id @default(uuid(7)) @db.Uuid
  companyId    String                 @map("company_id") @db.Uuid
  projectId    String                 @map("project_id") @db.Uuid
  runId        String                 @map("run_id") @db.Uuid
  position     Int
  severity     AiSeverity
  title        String
  detail       String
  evidence     Json                   @default("[]")
  status       AiRecommendationStatus @default(PROPOSED)
  decidedAt    DateTime?              @map("decided_at") @db.Timestamptz(6)
  decidedById  String?                @map("decided_by") @db.Uuid
  decisionNote String?                @map("decision_note")
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  run     AiRun   @relation(fields: [companyId, runId], references: [companyId, id], onDelete: Restrict)
  project Project @relation(fields: [companyId, projectId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, id])
  @@unique([runId, position])
  @@index([companyId, projectId, status])
  @@map("ai_recommendations")
}
