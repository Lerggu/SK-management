/// Versions are never overwritten: a trigger blocks changes to content
/// columns; only status/approval columns may change.
model DocumentVersion {
  id            String                @id @default(uuid(7)) @db.Uuid
  companyId     String                @map("company_id") @db.Uuid
  documentId    String                @map("document_id") @db.Uuid
  versionNumber Int                   @map("version_number")
  revisionLabel String?               @map("revision_label")
  fileName      String                @map("file_name")
  contentType   String                @map("content_type")
  sizeBytes     BigInt                @map("size_bytes")
  sha256        String                @db.Char(64)
  storageKey    String                @map("storage_key")
  status        DocumentVersionStatus @default(CURRENT)
  approvalState ApprovalState         @default(DRAFT) @map("approval_state")
  approvedById  String?               @map("approved_by") @db.Uuid
  approvedAt    DateTime?             @map("approved_at") @db.Timestamptz(6)
  issueDate     DateTime?             @map("issue_date") @db.Date
  changeNote    String?               @map("change_note")
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById   String?               @map("created_by") @db.Uuid
  updatedAt     DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById   String?               @map("updated_by") @db.Uuid

  document Document @relation(fields: [companyId, documentId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, id])
  @@unique([documentId, versionNumber])
  @@map("document_versions")
}

/// Polymorphic link from a document to another company-scoped entity.
/// The target's company is validated by the documents service.
model DocumentLink {
  id          String             @id @default(uuid(7)) @db.Uuid
  companyId   String             @map("company_id") @db.Uuid
  documentId  String             @map("document_id") @db.Uuid
  entityType  DocumentLinkEntity @map("entity_type")
  entityId    String             @map("entity_id") @db.Uuid
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?            @map("created_by") @db.Uuid
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById String?            @map("updated_by") @db.Uuid
  archivedAt  DateTime?          @map("archived_at") @db.Timestamptz(6)

  document Document @relation(fields: [companyId, documentId], references: [companyId, id], onDelete: Restrict)

  @@unique([documentId, entityType, entityId])
  @@index([companyId, entityType, entityId])
  @@map("document_links")
}

// ─────────────────────────────────────────────────────────────── System

/// Append-only. A trigger rejects UPDATE and DELETE. Written in the same
/// transaction as the change it describes. Sensitive values are masked.
model AuditEvent {
  id             String    @id @default(uuid(7)) @db.Uuid
  occurredAt     DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  organizationId String?   @map("organization_id") @db.Uuid
  companyId      String?   @map("company_id") @db.Uuid
  projectId      String?   @map("project_id") @db.Uuid
  actorType      ActorType @default(USER) @map("actor_type")
  actorUserId    String?   @map("actor_user_id") @db.Uuid
  action         String
  entityType     String    @map("entity_type")
  entityId       String?   @map("entity_id") @db.Uuid
  before         Json?
  after          Json?
  metadata       Json?

  @@index([companyId, occurredAt])
  @@index([companyId, entityType, entityId])
  @@index([actorUserId, occurredAt])
  @@map("audit_events")
}

// ─────────────────────────────────────────────────────────────── V2: Execution
// Time tracking, site diary and project finance (Build Master §19, §20, §22).

enum TimeEntryStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  EXPORTED
}

/// Owner decision (docs/V2_PLAN.md): cost multipliers 1.0 / 1.5 / 2.0 / 1.0.
enum WorkTimeClass {
  NORMAL
  OVERTIME_50
  OVERTIME_100
  TRAVEL
}

/// One person's hours on one project/site/day. Approved and exported entries
/// are locked (DB trigger); corrections are separate entries that reference
/// the original (correction_of_id) with a ± hours delta.
model TimeEntry {
  id              String          @id @default(uuid(7)) @db.Uuid
  companyId       String          @map("company_id") @db.Uuid
  employeeId      String          @map("employee_id") @db.Uuid
  projectId       String          @map("project_id") @db.Uuid
  siteId          String?         @map("site_id") @db.Uuid
  workDate        DateTime        @map("work_date") @db.Date
  startMinute     Int?            @map("start_minute")
  endMinute       Int?            @map("end_minute")
  hours           Decimal         @db.Decimal(5, 2)
  workClass       WorkTimeClass   @default(NORMAL) @map("work_class")
  note            String?
  status          TimeEntryStatus @default(DRAFT)
  correctionOfId  String?         @map("correction_of_id") @db.Uuid
  submittedAt     DateTime?       @map("submitted_at") @db.Timestamptz(6)
  submittedById   String?         @map("submitted_by") @db.Uuid
  decidedAt       DateTime?       @map("decided_at") @db.Timestamptz(6)
  decidedById     String?         @map("decided_by") @db.Uuid
  rejectionReason String?         @map("rejection_reason")
  exportedAt      DateTime?       @map("exported_at") @db.Timestamptz(6)
  exportBatchId   String?         @map("export_batch_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById     String?         @map("created_by") @db.Uuid
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById     String?         @map("updated_by") @db.Uuid
  archivedAt      DateTime?       @map("archived_at") @db.Timestamptz(6)

  company      Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee     Employee    @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict)
  project      Project     @relation(fields: [companyId, projectId], references: [companyId, id], onDelete: Restrict)
  site         Site?       @relation(fields: [companyId, projectId, siteId], references: [companyId, projectId, id], onDelete: Restrict)
  correctionOf TimeEntry?  @relation("TimeEntryCorrection", fields: [companyId, correctionOfId], references: [companyId, id], onDelete: Restrict)
  corrections  TimeEntry[] @relation("TimeEntryCorrection")

  @@unique([companyId, id])
  @@index([companyId, employeeId, workDate])
  @@index([companyId, projectId, status, workDate])
  @@index([companyId, exportBatchId])
  @@map("time_entries")
}

enum DailyReportStatus {
  DRAFT
  SIGNED
}

enum DailyReportEntryKind {
  WORK
  EQUIPMENT
  DELAY
  INSTRUCTION
}

/// Site diary: one per site and day. Signing locks it (DB trigger) and
