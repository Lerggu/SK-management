enum IncidentSeverity {
  FIRST_AID
  MEDICAL_TREATMENT
  LOST_TIME
  SERIOUS
}

enum IncidentStatus {
  REPORTED
  TRIAGED
  INVESTIGATING
  CLOSED
}

model Incident {
