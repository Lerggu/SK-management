// SK Management — V1 Foundation schema.
//
// Conventions (see docs/adr):
// - UUIDv7 primary keys generated by Prisma (`uuid(7)`).
// - All timestamps are `timestamptz` and stored in UTC.
// - Company-scoped tables carry `company_id` and expose `@@unique([companyId, id])`
//   so that child tables can reference them with composite foreign keys
//   (`(company_id, parent_id) -> parent(company_id, id)`). This makes
//   cross-company references impossible at the database level.
// - Records are archived (`archived_at`) instead of hard-deleted.
// - Money is numeric(14,2) plus an ISO-4217 currency code.
// - created_by / updated_by hold user ids without FK relations to keep the
//   audit columns cheap; the audit trail is authoritative for "who".
//
// Raw-SQL objects that Prisma does not model (triggers, check constraints,
// partial unique indexes) live in migrations and are listed in
// docs/adr/0004-database-integrity.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────── Enums

enum UserStatus {
  ACTIVE
  DISABLED
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum ProjectAccess {
  ALL
  ASSIGNED
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
}

enum SiteStatus {
  ACTIVE
  CLOSED
}

enum ResourceStatus {
  ACTIVE
  INACTIVE
}

enum EmploymentType {
  EMPLOYEE
  CONTRACTOR
  TEMPORARY
}

enum EquipmentCategory {
  CRANE
  TELEHANDLER
  EXCAVATOR
  WHEEL_LOADER
  FORKLIFT
  AERIAL_PLATFORM
  VEHICLE
  LIFTING_ACCESSORY
  CABLE_EQUIPMENT
  OTHER
}

enum EquipmentStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  OUT_OF_SERVICE
}

enum RateType {
  COST
  BILLING
}

enum RateUnit {
  HOUR
  DAY
}

enum DocumentCategory {
  CONTRACT
  DRAWING
  RAMS
  LIFT_PLAN
  ELECTRICAL_PLAN
  INSPECTION
  CERTIFICATE
  MANUAL
  OTHER
}

enum DocumentVersionStatus {
  CURRENT
  SUPERSEDED
}

enum ApprovalState {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum DocumentLinkEntity {
  PROJECT
  SITE
  EMPLOYEE
  EQUIPMENT
}

enum ActorType {
  USER
  SYSTEM
}

// ─────────────────────────────────────────────────────────────── Identity

model Organization {
  id          String    @id @default(uuid(7)) @db.Uuid
  slug        String    @unique
  name        String
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById String?   @map("updated_by") @db.Uuid
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(6)

  companies   Company[]
  memberships OrganizationMembership[]

  @@map("organizations")
}

model Company {
  id              String    @id @default(uuid(7)) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  slug            String    @unique
  name            String
  businessId      String?   @map("business_id")
  defaultCurrency String    @default("EUR") @map("default_currency") @db.Char(3)
  defaultLocale   String    @default("fi") @map("default_locale")
  timezone        String    @default("Europe/Helsinki")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById     String?   @map("created_by") @db.Uuid
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById     String?   @map("updated_by") @db.Uuid
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(6)

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberships    CompanyMembership[]
  roles          Role[]
  projects       Project[]
  sites          Site[]
  employees      Employee[]
  employeeRates  EmployeeRate[]
  equipmentTypes EquipmentType[]
  equipment      Equipment[]
  equipmentRates EquipmentRate[]
  documents      Document[]
  timeEntries    TimeEntry[]
  dailyReports   DailyReport[]
  budgets        Budget[]
  costEntries    CostEntry[]
  workCalendars  WorkCalendar[]

  @@index([organizationId])
  @@map("companies")
}

model User {
  id            String     @id @default(uuid(7)) @db.Uuid
  email         String     @unique
  name          String?
  emailVerified DateTime?  @map("email_verified") @db.Timestamptz(6)
  image         String?
  locale        String?
  status        UserStatus @default(ACTIVE)
  lastCompanyId String?    @map("last_company_id") @db.Uuid
  lastSignInAt  DateTime?  @map("last_sign_in_at") @db.Timestamptz(6)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById   String?    @map("created_by") @db.Uuid
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById   String?    @map("updated_by") @db.Uuid
  archivedAt    DateTime?  @map("archived_at") @db.Timestamptz(6)

  identities              UserIdentity[]
  accounts                Account[]
  sessions                Session[]
  organizationMemberships OrganizationMembership[]
  companyMemberships      CompanyMembership[]

  @@map("users")
}

/// Provider-independent record of an external identity used to sign in
/// (Entra object id, dev login). Auth.js `accounts` holds OAuth tokens.
model UserIdentity {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  provider     String
  subject      String
  tenantId     String?   @map("tenant_id")
  email        String?
  lastSignInAt DateTime? @map("last_sign_in_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, subject])
  @@index([userId])
  @@map("user_identities")
}

/// Auth.js adapter table (OAuth accounts).
model Account {
  id                       String   @id @default(uuid(7)) @db.Uuid
  userId                   String   @map("user_id") @db.Uuid
  type                     String
  provider                 String
  providerAccountId        String   @map("provider_account_id")
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  /// Microsoft Entra returns these in its token response.
  ext_expires_in           Int?
  refresh_token_expires_in Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/// Auth.js adapter table (database sessions).
model Session {
  id           String   @id @default(uuid(7)) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model OrganizationMembership {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole @default(MEMBER)
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById    String?          @map("created_by") @db.Uuid
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById    String?          @map("updated_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_memberships")
}

model CompanyMembership {
  id          String           @id @default(uuid(7)) @db.Uuid
  companyId   String           @map("company_id") @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  status      MembershipStatus @default(INVITED)
  invitedAt   DateTime?        @map("invited_at") @db.Timestamptz(6)
  invitedById String?          @map("invited_by") @db.Uuid
  acceptedAt  DateTime?        @map("accepted_at") @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?          @map("created_by") @db.Uuid
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById String?          @map("updated_by") @db.Uuid

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  roles              MembershipRole[]
  projectMemberships ProjectMembership[]

  @@unique([companyId, id])
  @@unique([companyId, userId])
  @@index([userId])
  @@map("company_memberships")
}

/// Company-scoped role, instantiated from a system template (templateKey)
/// or created by the company. Code checks permissions, never role names.
model Role {
  id            String        @id @default(uuid(7)) @db.Uuid
  companyId     String        @map("company_id") @db.Uuid
  key           String
  templateKey   String?       @map("template_key")
  name          String
  description   String?
  projectAccess ProjectAccess @default(ASSIGNED) @map("project_access")
  isSystem      Boolean       @default(false) @map("is_system")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById   String?       @map("created_by") @db.Uuid
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById   String?       @map("updated_by") @db.Uuid
  archivedAt    DateTime?     @map("archived_at") @db.Timestamptz(6)

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  permissions        RolePermission[]
  membershipRoles    MembershipRole[]
  projectMemberships ProjectMembership[]

  @@unique([companyId, id])
  @@unique([companyId, key])
  @@map("roles")
}

/// Global permission catalogue (capabilities).
model Permission {
  key         String  @id
  category    String
  description String
  isSensitive Boolean @default(false) @map("is_sensitive")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  companyId     String   @map("company_id") @db.Uuid
  roleId        String   @map("role_id") @db.Uuid
  permissionKey String   @map("permission_key")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById   String?  @map("created_by") @db.Uuid

  role       Role       @relation(fields: [companyId, roleId], references: [companyId, id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Restrict)

  @@id([roleId, permissionKey])
  @@index([companyId])
  @@map("role_permissions")
}

model MembershipRole {
  companyId    String   @map("company_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById  String?  @map("created_by") @db.Uuid

  membership CompanyMembership @relation(fields: [companyId, membershipId], references: [companyId, id], onDelete: Cascade)
  role       Role              @relation(fields: [companyId, roleId], references: [companyId, id], onDelete: Restrict)

  @@id([membershipId, roleId])
  @@index([companyId])
  @@map("membership_roles")
}

/// Assigns a company member to a project with a project-level role.
/// Effective permissions inside the project = company roles ∪ project role.
model ProjectMembership {
  id          String    @id @default(uuid(7)) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  roleId      String    @map("role_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById String?   @map("updated_by") @db.Uuid
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(6)

  project    Project           @relation(fields: [companyId, projectId], references: [companyId, id], onDelete: Restrict)
  membership CompanyMembership @relation(fields: [companyId, userId], references: [companyId, userId], onDelete: Restrict)
  role       Role              @relation(fields: [companyId, roleId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, id])
  @@unique([projectId, userId])
  @@index([companyId, userId])
  @@map("project_memberships")
}

// ─────────────────────────────────────────────────────────────── Projects
// Hierarchy: Company → Project → Site → (V3: Building/Area → Takt Area →
// Work Package → Activity). Sites expose @@unique([companyId, projectId, id])
// so future child tables can reference (company_id, project_id, site_id).

model Project {
  id           String        @id @default(uuid(7)) @db.Uuid
  companyId    String        @map("company_id") @db.Uuid
  code         String
  name         String
  customerName String?       @map("customer_name")
  description  String?
  status       ProjectStatus @default(PLANNED)
  startDate    DateTime?     @map("start_date") @db.Date
  endDate      DateTime?     @map("end_date") @db.Date
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById  String?       @map("created_by") @db.Uuid
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById  String?       @map("updated_by") @db.Uuid
  archivedAt   DateTime?     @map("archived_at") @db.Timestamptz(6)

  company      Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sites        Site[]
  memberships  ProjectMembership[]
  equipment    Equipment[]
  documents    Document[]
  timeEntries  TimeEntry[]
  budgets      Budget[]
  costEntries  CostEntry[]
  workPackages WorkPackage[]

  @@unique([companyId, id])
  @@unique([companyId, code])
  @@index([companyId, archivedAt])
  @@map("projects")
}

model Site {
  id          String     @id @default(uuid(7)) @db.Uuid
  companyId   String     @map("company_id") @db.Uuid
  projectId   String     @map("project_id") @db.Uuid
  code        String?
  name        String
  address     String?
  postalCode  String?    @map("postal_code")
  city        String?
  latitude    Decimal?   @db.Decimal(9, 6)
  longitude   Decimal?   @db.Decimal(9, 6)
  status      SiteStatus @default(ACTIVE)
  notes       String?
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?    @map("created_by") @db.Uuid
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById String?    @map("updated_by") @db.Uuid
  archivedAt  DateTime?  @map("archived_at") @db.Timestamptz(6)

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project      Project       @relation(fields: [companyId, projectId], references: [companyId, id], onDelete: Restrict)
  equipment    Equipment[]
  documents    Document[]
  timeEntries  TimeEntry[]
  dailyReports DailyReport[]
  costEntries  CostEntry[]
  buildings    Building[]
  taktPlans    TaktPlan[]

  @@unique([companyId, id])
  @@unique([companyId, projectId, id])
  @@index([companyId, projectId])
  @@map("sites")
}

// ─────────────────────────────────────────────────────────────── Workforce
// Employees are future bookable resources (V4): stable id, owning company,
// status. Cross-company use will be a booking, never a change of company_id.

model Employee {
  id             String         @id @default(uuid(7)) @db.Uuid
  companyId      String         @map("company_id") @db.Uuid
  employeeNumber String         @map("employee_number")
  firstName      String         @map("first_name")
  lastName       String         @map("last_name")
  email          String?
  phone          String?
  jobTitle       String?        @map("job_title")
  trade          String?
  employmentType EmploymentType @default(EMPLOYEE) @map("employment_type")
  status         ResourceStatus @default(ACTIVE)
  userId         String?        @map("user_id") @db.Uuid
  startDate      DateTime?      @map("start_date") @db.Date
  endDate        DateTime?      @map("end_date") @db.Date
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById    String?        @map("created_by") @db.Uuid
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById    String?        @map("updated_by") @db.Uuid
  archivedAt     DateTime?      @map("archived_at") @db.Timestamptz(6)

  company     Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  rates       EmployeeRate[]
  timeEntries TimeEntry[]

  @@unique([companyId, id])
  @@unique([companyId, employeeNumber])
  @@index([companyId, archivedAt])
  @@map("employees")
}

/// Sensitive: readable only with `employee.rates.view`.
model EmployeeRate {
  id          String    @id @default(uuid(7)) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  employeeId  String    @map("employee_id") @db.Uuid
  rateType    RateType  @map("rate_type")
  unit        RateUnit  @default(HOUR)
  amount      Decimal   @db.Decimal(14, 2)
  currency    String    @default("EUR") @db.Char(3)
  validFrom   DateTime  @map("valid_from") @db.Date
  validTo     DateTime? @map("valid_to") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById String?   @map("updated_by") @db.Uuid
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(6)

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, id])
  @@index([companyId, employeeId, rateType, validFrom])
  @@map("employee_rates")
}

// ─────────────────────────────────────────────────────────────── Equipment

model EquipmentType {
  id          String            @id @default(uuid(7)) @db.Uuid
  companyId   String            @map("company_id") @db.Uuid
  name        String
  category    EquipmentCategory @default(OTHER)
  description String?
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?           @map("created_by") @db.Uuid
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById String?           @map("updated_by") @db.Uuid
  archivedAt  DateTime?         @map("archived_at") @db.Timestamptz(6)

  company        Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  equipment      Equipment[]
  workPackages   WorkPackage[]
  taktActivities TaktActivity[]
  requirements   ResourceRequirement[]

  @@unique([companyId, id])
  @@unique([companyId, name])
  @@map("equipment_types")
}

/// Owned by exactly one company. Future cross-company use (V4) is a booking.
model Equipment {
  id                 String          @id @default(uuid(7)) @db.Uuid
  companyId          String          @map("company_id") @db.Uuid
  equipmentTypeId    String          @map("equipment_type_id") @db.Uuid
  assetNumber        String          @map("asset_number")
  name               String
  manufacturer       String?
  model              String?
  serialNumber       String?         @map("serial_number")
  registrationNumber String?         @map("registration_number")
  status             EquipmentStatus @default(AVAILABLE)
  currentProjectId   String?         @map("current_project_id") @db.Uuid
  currentSiteId      String?         @map("current_site_id") @db.Uuid
  meterHours         Decimal?        @map("meter_hours") @db.Decimal(10, 1)
  nextInspectionDate DateTime?       @map("next_inspection_date") @db.Date
  notes              String?
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById        String?         @map("created_by") @db.Uuid
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById        String?         @map("updated_by") @db.Uuid
  archivedAt         DateTime?       @map("archived_at") @db.Timestamptz(6)

  company        Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  equipmentType  EquipmentType      @relation(fields: [companyId, equipmentTypeId], references: [companyId, id], onDelete: Restrict)
  currentProject Project?           @relation(fields: [companyId, currentProjectId], references: [companyId, id], onDelete: Restrict)
  currentSite    Site?              @relation(fields: [companyId, currentProjectId, currentSiteId], references: [companyId, projectId, id], onDelete: Restrict)
  rates          EquipmentRate[]
  diaryEntries   DailyReportEntry[]

  @@unique([companyId, id])
  @@unique([companyId, assetNumber])
  @@index([companyId, archivedAt])
  @@map("equipment")
}

/// Sensitive: readable only with `equipment.rates.view`.
model EquipmentRate {
  id          String    @id @default(uuid(7)) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  equipmentId String    @map("equipment_id") @db.Uuid
  rateType    RateType  @map("rate_type")
  unit        RateUnit  @default(HOUR)
  amount      Decimal   @db.Decimal(14, 2)
  currency    String    @default("EUR") @db.Char(3)
  validFrom   DateTime  @map("valid_from") @db.Date
  validTo     DateTime? @map("valid_to") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById String?   @map("updated_by") @db.Uuid
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(6)

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  equipment Equipment @relation(fields: [companyId, equipmentId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, id])
  @@index([companyId, equipmentId, rateType, validFrom])
  @@map("equipment_rates")
}

// ─────────────────────────────────────────────────────────────── Documents

model Document {
  id             String           @id @default(uuid(7)) @db.Uuid
  companyId      String           @map("company_id") @db.Uuid
  projectId      String?          @map("project_id") @db.Uuid
  siteId         String?          @map("site_id") @db.Uuid
  title          String
  documentNumber String?          @map("document_number")
  category       DocumentCategory @default(OTHER)
  description    String?
  ownerUserId    String?          @map("owner_user_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById    String?          @map("created_by") @db.Uuid
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById    String?          @map("updated_by") @db.Uuid
  archivedAt     DateTime?        @map("archived_at") @db.Timestamptz(6)

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project  Project?          @relation(fields: [companyId, projectId], references: [companyId, id], onDelete: Restrict)
  site     Site?             @relation(fields: [companyId, projectId, siteId], references: [companyId, projectId, id], onDelete: Restrict)
  versions DocumentVersion[]
  links    DocumentLink[]

  @@unique([companyId, id])
  @@index([companyId, projectId])
  @@index([companyId, archivedAt])
  @@map("documents")
}

/// Versions are never overwritten: a trigger blocks changes to content
/// columns; only status/approval columns may change.
model DocumentVersion {
  id            String                @id @default(uuid(7)) @db.Uuid
  companyId     String                @map("company_id") @db.Uuid
  documentId    String                @map("document_id") @db.Uuid
  versionNumber Int                   @map("version_number")
  revisionLabel String?               @map("revision_label")
  fileName      String                @map("file_name")
  contentType   String                @map("content_type")
  sizeBytes     BigInt                @map("size_bytes")
  sha256        String                @db.Char(64)
  storageKey    String                @map("storage_key")
  status        DocumentVersionStatus @default(CURRENT)
  approvalState ApprovalState         @default(DRAFT) @map("approval_state")
  approvedById  String?               @map("approved_by") @db.Uuid
  approvedAt    DateTime?             @map("approved_at") @db.Timestamptz(6)
  issueDate     DateTime?             @map("issue_date") @db.Date
  changeNote    String?               @map("change_note")
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById   String?               @map("created_by") @db.Uuid
  updatedAt     DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById   String?               @map("updated_by") @db.Uuid

  document Document @relation(fields: [companyId, documentId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, id])
  @@unique([documentId, versionNumber])
  @@map("document_versions")
}

/// Polymorphic link from a document to another company-scoped entity.
/// The target's company is validated by the documents service.
model DocumentLink {
  id          String             @id @default(uuid(7)) @db.Uuid
  companyId   String             @map("company_id") @db.Uuid
  documentId  String             @map("document_id") @db.Uuid
  entityType  DocumentLinkEntity @map("entity_type")
  entityId    String             @map("entity_id") @db.Uuid
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?            @map("created_by") @db.Uuid
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById String?            @map("updated_by") @db.Uuid
  archivedAt  DateTime?          @map("archived_at") @db.Timestamptz(6)

  document Document @relation(fields: [companyId, documentId], references: [companyId, id], onDelete: Restrict)

  @@unique([documentId, entityType, entityId])
  @@index([companyId, entityType, entityId])
  @@map("document_links")
}

// ─────────────────────────────────────────────────────────────── System

/// Append-only. A trigger rejects UPDATE and DELETE. Written in the same
/// transaction as the change it describes. Sensitive values are masked.
model AuditEvent {
  id             String    @id @default(uuid(7)) @db.Uuid
  occurredAt     DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  organizationId String?   @map("organization_id") @db.Uuid
  companyId      String?   @map("company_id") @db.Uuid
  projectId      String?   @map("project_id") @db.Uuid
  actorType      ActorType @default(USER) @map("actor_type")
  actorUserId    String?   @map("actor_user_id") @db.Uuid
  action         String
  entityType     String    @map("entity_type")
  entityId       String?   @map("entity_id") @db.Uuid
  before         Json?
  after          Json?
  metadata       Json?

  @@index([companyId, occurredAt])
  @@index([companyId, entityType, entityId])
  @@index([actorUserId, occurredAt])
  @@map("audit_events")
}

// ─────────────────────────────────────────────────────────────── V2: Execution
// Time tracking, site diary and project finance (Build Master §19, §20, §22).

enum TimeEntryStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  EXPORTED
}

/// Owner decision (docs/V2_PLAN.md): cost multipliers 1.0 / 1.5 / 2.0 / 1.0.
enum WorkTimeClass {
  NORMAL
  OVERTIME_50
  OVERTIME_100
  TRAVEL
}

/// One person's hours on one project/site/day. Approved and exported entries
/// are locked (DB trigger); corrections are separate entries that reference
/// the original (correction_of_id) with a ± hours delta.
model TimeEntry {
  id              String          @id @default(uuid(7)) @db.Uuid
  companyId       String          @map("company_id") @db.Uuid
  employeeId      String          @map("employee_id") @db.Uuid
  projectId       String          @map("project_id") @db.Uuid
  siteId          String?         @map("site_id") @db.Uuid
  workDate        DateTime        @map("work_date") @db.Date
  startMinute     Int?            @map("start_minute")
  endMinute       Int?            @map("end_minute")
  hours           Decimal         @db.Decimal(5, 2)
  workClass       WorkTimeClass   @default(NORMAL) @map("work_class")
  note            String?
  status          TimeEntryStatus @default(DRAFT)
  correctionOfId  String?         @map("correction_of_id") @db.Uuid
  submittedAt     DateTime?       @map("submitted_at") @db.Timestamptz(6)
  submittedById   String?         @map("submitted_by") @db.Uuid
  decidedAt       DateTime?       @map("decided_at") @db.Timestamptz(6)
  decidedById     String?         @map("decided_by") @db.Uuid
  rejectionReason String?         @map("rejection_reason")
  exportedAt      DateTime?       @map("exported_at") @db.Timestamptz(6)
  exportBatchId   String?         @map("export_batch_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById     String?         @map("created_by") @db.Uuid
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById     String?         @map("updated_by") @db.Uuid
  archivedAt      DateTime?       @map("archived_at") @db.Timestamptz(6)

  company      Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee     Employee    @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict)
  project      Project     @relation(fields: [companyId, projectId], references: [companyId, id], onDelete: Restrict)
  site         Site?       @relation(fields: [companyId, projectId, siteId], references: [companyId, projectId, id], onDelete: Restrict)
  correctionOf TimeEntry?  @relation("TimeEntryCorrection", fields: [companyId, correctionOfId], references: [companyId, id], onDelete: Restrict)
  corrections  TimeEntry[] @relation("TimeEntryCorrection")

  @@unique([companyId, id])
  @@index([companyId, employeeId, workDate])
  @@index([companyId, projectId, status, workDate])
  @@index([companyId, exportBatchId])
  @@map("time_entries")
}

enum DailyReportStatus {
  DRAFT
  SIGNED
}

enum DailyReportEntryKind {
  WORK
  EQUIPMENT
  DELAY
  INSTRUCTION
}

/// Site diary: one per site and day. Signing locks it (DB trigger) and
/// freezes the attendance snapshot.
model DailyReport {
  id                 String            @id @default(uuid(7)) @db.Uuid
  companyId          String            @map("company_id") @db.Uuid
  projectId          String            @map("project_id") @db.Uuid
  siteId             String            @map("site_id") @db.Uuid
  reportDate         DateTime          @map("report_date") @db.Date
  status             DailyReportStatus @default(DRAFT)
  weather            String?
  summary            String?
  attendanceSnapshot Json?             @map("attendance_snapshot")
  signedAt           DateTime?         @map("signed_at") @db.Timestamptz(6)
  signedById         String?           @map("signed_by") @db.Uuid
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById        String?           @map("created_by") @db.Uuid
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById        String?           @map("updated_by") @db.Uuid

  company     Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  site        Site                    @relation(fields: [companyId, projectId, siteId], references: [companyId, projectId, id], onDelete: Restrict)
  entries     DailyReportEntry[]
  attachments DailyReportAttachment[]

  @@unique([companyId, id])
  @@unique([siteId, reportDate])
  @@index([companyId, projectId, reportDate])
  @@map("daily_reports")
}

model DailyReportEntry {
  id            String               @id @default(uuid(7)) @db.Uuid
  companyId     String               @map("company_id") @db.Uuid
  dailyReportId String               @map("daily_report_id") @db.Uuid
  kind          DailyReportEntryKind
  description   String?
  equipmentId   String?              @map("equipment_id") @db.Uuid
  hours         Decimal?             @db.Decimal(6, 2)
  /// Added after signing (audited addendum).
  isAddendum    Boolean              @default(false) @map("is_addendum")
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById   String?              @map("created_by") @db.Uuid

  dailyReport DailyReport @relation(fields: [companyId, dailyReportId], references: [companyId, id], onDelete: Restrict)
  equipment   Equipment?  @relation(fields: [companyId, equipmentId], references: [companyId, id], onDelete: Restrict)

  @@index([companyId, dailyReportId])
  @@index([companyId, equipmentId])
  @@map("daily_report_entries")
}

model DailyReportAttachment {
  id            String   @id @default(uuid(7)) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  dailyReportId String   @map("daily_report_id") @db.Uuid
  fileName      String   @map("file_name")
  contentType   String   @map("content_type")
  sizeBytes     BigInt   @map("size_bytes")
  sha256        String   @db.Char(64)
  storageKey    String   @map("storage_key")
  caption       String?
  isAddendum    Boolean  @default(false) @map("is_addendum")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById   String?  @map("created_by") @db.Uuid

  dailyReport DailyReport @relation(fields: [companyId, dailyReportId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, id])
  @@index([companyId, dailyReportId])
  @@map("daily_report_attachments")
}

enum CostCategory {
  LABOR
  EQUIPMENT
  MATERIALS
  SUBCONTRACT
  OTHER
}

enum BudgetStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
}

/// Budget version per project. Version 1 is the original budget. Lines are
/// editable only in DRAFT; activating a version supersedes the previous one.
model Budget {
  id            String       @id @default(uuid(7)) @db.Uuid
  companyId     String       @map("company_id") @db.Uuid
  projectId     String       @map("project_id") @db.Uuid
  versionNumber Int          @map("version_number")
  status        BudgetStatus @default(DRAFT)
  currency      String       @default("EUR") @db.Char(3)
  note          String?
  activatedAt   DateTime?    @map("activated_at") @db.Timestamptz(6)
  activatedById String?      @map("activated_by") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById   String?      @map("created_by") @db.Uuid
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById   String?      @map("updated_by") @db.Uuid

  company Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project Project      @relation(fields: [companyId, projectId], references: [companyId, id], onDelete: Restrict)
  lines   BudgetLine[]

  @@unique([companyId, id])
  @@unique([projectId, versionNumber])
  @@map("budgets")
}

model BudgetLine {
  id          String       @id @default(uuid(7)) @db.Uuid
  companyId   String       @map("company_id") @db.Uuid
  budgetId    String       @map("budget_id") @db.Uuid
  category    CostCategory
  description String
  amount      Decimal      @db.Decimal(14, 2)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?      @map("created_by") @db.Uuid
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById String?      @map("updated_by") @db.Uuid

  budget Budget @relation(fields: [companyId, budgetId], references: [companyId, id], onDelete: Cascade)

  @@unique([companyId, id])
  @@index([companyId, budgetId])
  @@map("budget_lines")
}

/// Manually recorded project cost (materials, subcontracting, rentals…).
/// Labour and diary equipment costs are computed, not entered here.
model CostEntry {
  id          String       @id @default(uuid(7)) @db.Uuid
  companyId   String       @map("company_id") @db.Uuid
  projectId   String       @map("project_id") @db.Uuid
  siteId      String?      @map("site_id") @db.Uuid
  category    CostCategory
  entryDate   DateTime     @map("entry_date") @db.Date
  description String
  supplier    String?
  reference   String?
  amount      Decimal      @db.Decimal(14, 2)
  currency    String       @default("EUR") @db.Char(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?      @map("created_by") @db.Uuid
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById String?      @map("updated_by") @db.Uuid
  archivedAt  DateTime?    @map("archived_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project Project @relation(fields: [companyId, projectId], references: [companyId, id], onDelete: Restrict)
  site    Site?   @relation(fields: [companyId, projectId, siteId], references: [companyId, projectId, id], onDelete: Restrict)

  @@unique([companyId, id])
  @@index([companyId, projectId, entryDate])
  @@map("cost_entries")
}

// ─────────────────────────────────────────────────────────────── V3 — Takt
// Hierarchy: Site → Building/Area → Takt Area; Work Packages are project-level
// trades ("wagons"); an Activity is one work package in one takt area of a
// site plan. Planned dates live in versioned assignments (DRAFT → PROPOSED →
// BASELINE → SUPERSEDED); a baseline is frozen by DB triggers. Actual dates,
// progress and constraints are facts on the activity and are not versioned.
// See docs/adr/0012-takt-plan-versioning.md.

/// Company working calendar: working weekdays (ISO 1 = Monday … 7 = Sunday)
/// and public holidays. Day-takt cycles skip non-working days.
model WorkCalendar {
  id              String    @id @default(uuid(7)) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  name            String
  workingWeekdays Int[]     @default([1, 2, 3, 4, 5]) @map("working_weekdays")
  isDefault       Boolean   @default(false) @map("is_default")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById     String?   @map("created_by") @db.Uuid
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById     String?   @map("updated_by") @db.Uuid
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(6)

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  holidays CalendarHoliday[]
  plans    TaktPlan[]

  @@unique([companyId, id])
  @@unique([companyId, name])
  @@map("work_calendars")
}

model CalendarHoliday {
  id          String   @id @default(uuid(7)) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  calendarId  String   @map("calendar_id") @db.Uuid
  date        DateTime @db.Date
  name        String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?  @map("created_by") @db.Uuid

  calendar WorkCalendar @relation(fields: [companyId, calendarId], references: [companyId, id], onDelete: Cascade)

  @@unique([companyId, id])
  @@unique([calendarId, date])
  @@map("calendar_holidays")
}

enum BuildingKind {
  BUILDING
  AREA
}

model Building {
  id          String       @id @default(uuid(7)) @db.Uuid
  companyId   String       @map("company_id") @db.Uuid
  projectId   String       @map("project_id") @db.Uuid
  siteId      String       @map("site_id") @db.Uuid
  code        String?
  name        String
  kind        BuildingKind @default(BUILDING)
  sortOrder   Int          @default(0) @map("sort_order")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?      @map("created_by") @db.Uuid
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById String?      @map("updated_by") @db.Uuid
  archivedAt  DateTime?    @map("archived_at") @db.Timestamptz(6)

  site      Site       @relation(fields: [companyId, projectId, siteId], references: [companyId, projectId, id], onDelete: Restrict)
  taktAreas TaktArea[]

  @@unique([companyId, id])
  @@unique([companyId, siteId, id])
  @@unique([siteId, name])
  @@map("buildings")
}

model TaktArea {
  id          String    @id @default(uuid(7)) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  siteId      String    @map("site_id") @db.Uuid
  buildingId  String    @map("building_id") @db.Uuid
  code        String
  name        String
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById String?   @map("updated_by") @db.Uuid
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(6)

  building   Building       @relation(fields: [companyId, siteId, buildingId], references: [companyId, siteId, id], onDelete: Restrict)
  activities TaktActivity[]

  @@unique([companyId, id])
  @@unique([companyId, siteId, id])
  @@unique([buildingId, code])
  @@map("takt_areas")
}

/// A trade "wagon" of the takt train, reusable across the project's sites.
model WorkPackage {
  id                    String    @id @default(uuid(7)) @db.Uuid
  companyId             String    @map("company_id") @db.Uuid
  projectId             String    @map("project_id") @db.Uuid
  code                  String
  name                  String
  trade                 String?
  color                 String    @default("#1E88A8")
  defaultCrewSize       Int       @default(2) @map("default_crew_size")
  defaultDurationCycles Int       @default(1) @map("default_duration_cycles")
  equipmentTypeId       String?   @map("equipment_type_id") @db.Uuid
  equipmentCount        Int       @default(0) @map("equipment_count")
  sortOrder             Int       @default(0) @map("sort_order")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById           String?   @map("created_by") @db.Uuid
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById           String?   @map("updated_by") @db.Uuid
  archivedAt            DateTime? @map("archived_at") @db.Timestamptz(6)

  project       Project        @relation(fields: [companyId, projectId], references: [companyId, id], onDelete: Restrict)
  equipmentType EquipmentType? @relation(fields: [companyId, equipmentTypeId], references: [companyId, id], onDelete: Restrict)
  activities    TaktActivity[]

  @@unique([companyId, id])
  @@unique([companyId, projectId, id])
  @@unique([projectId, code])
  @@map("work_packages")
}

/// One takt plan per site (or several named alternatives).
model TaktPlan {
  id              String    @id @default(uuid(7)) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  projectId       String    @map("project_id") @db.Uuid
  siteId          String    @map("site_id") @db.Uuid
  calendarId      String    @map("calendar_id") @db.Uuid
  name            String
  cycleLengthDays Int       @default(1) @map("cycle_length_days")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById     String?   @map("created_by") @db.Uuid
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById     String?   @map("updated_by") @db.Uuid
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(6)

  site       Site              @relation(fields: [companyId, projectId, siteId], references: [companyId, projectId, id], onDelete: Restrict)
  calendar   WorkCalendar      @relation(fields: [companyId, calendarId], references: [companyId, id], onDelete: Restrict)
  versions   TaktPlanVersion[]
  activities TaktActivity[]
  imports    ScheduleImport[]

  @@unique([companyId, id])
  @@unique([companyId, projectId, siteId, id])
  @@unique([siteId, name])
  @@map("takt_plans")
}

enum TaktPlanVersionStatus {
  DRAFT
  PROPOSED
  BASELINE
  SUPERSEDED
}

/// Plan version. Only DRAFT versions are editable; at most one DRAFT/PROPOSED
/// and one BASELINE per plan (partial unique indexes). BASELINE/SUPERSEDED
/// versions are frozen by a DB trigger.
model TaktPlanVersion {
  id            String                @id @default(uuid(7)) @db.Uuid
  companyId     String                @map("company_id") @db.Uuid
  planId        String                @map("plan_id") @db.Uuid
  versionNumber Int                   @map("version_number")
  status        TaktPlanVersionStatus @default(DRAFT)
  startDate     DateTime              @map("start_date") @db.Date
  reason        String?
  basedOnId     String?               @map("based_on_id") @db.Uuid
  proposedAt    DateTime?             @map("proposed_at") @db.Timestamptz(6)
  proposedById  String?               @map("proposed_by") @db.Uuid
  approvedAt    DateTime?             @map("approved_at") @db.Timestamptz(6)
  approvedById  String?               @map("approved_by") @db.Uuid
  supersededAt  DateTime?             @map("superseded_at") @db.Timestamptz(6)
  returnedNote  String?               @map("returned_note")
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById   String?               @map("created_by") @db.Uuid
  updatedAt     DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById   String?               @map("updated_by") @db.Uuid

  plan         TaktPlan              @relation(fields: [companyId, planId], references: [companyId, id], onDelete: Restrict)
  assignments  TaktAssignment[]
  requirements ResourceRequirement[]

  @@unique([companyId, id])
  @@unique([companyId, planId, id])
  @@unique([planId, versionNumber])
  @@map("takt_plan_versions")
}

enum ActivityExecution {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
}

/// Work package × takt area within a plan. Requirements (crew, equipment)
/// default from the work package. Actuals and progress are not versioned.
model TaktActivity {
  id              String            @id @default(uuid(7)) @db.Uuid
  companyId       String            @map("company_id") @db.Uuid
  projectId       String            @map("project_id") @db.Uuid
  siteId          String            @map("site_id") @db.Uuid
  planId          String            @map("plan_id") @db.Uuid
  taktAreaId      String            @map("takt_area_id") @db.Uuid
  workPackageId   String            @map("work_package_id") @db.Uuid
  name            String
  crewTrade       String?           @map("crew_trade")
  crewSize        Int               @default(0) @map("crew_size")
  equipmentTypeId String?           @map("equipment_type_id") @db.Uuid
  equipmentCount  Int               @default(0) @map("equipment_count")
  execution       ActivityExecution @default(NOT_STARTED)
  progressPct     Int               @default(0) @map("progress_pct")
  actualStart     DateTime?         @map("actual_start") @db.Date
  actualEnd       DateTime?         @map("actual_end") @db.Date
  blocked         Boolean           @default(false)
  delayReason     String?           @map("delay_reason")
  recoveryAction  String?           @map("recovery_action")
  externalRef     String?           @map("external_ref")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById     String?           @map("created_by") @db.Uuid
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById     String?           @map("updated_by") @db.Uuid
  archivedAt      DateTime?         @map("archived_at") @db.Timestamptz(6)

  plan          TaktPlan              @relation(fields: [companyId, projectId, siteId, planId], references: [companyId, projectId, siteId, id], onDelete: Restrict)
  taktArea      TaktArea              @relation(fields: [companyId, siteId, taktAreaId], references: [companyId, siteId, id], onDelete: Restrict)
  workPackage   WorkPackage           @relation(fields: [companyId, projectId, workPackageId], references: [companyId, projectId, id], onDelete: Restrict)
  equipmentType EquipmentType?        @relation(fields: [companyId, equipmentTypeId], references: [companyId, id], onDelete: Restrict)
  assignments   TaktAssignment[]
  predecessors  ActivityDependency[]  @relation("DependencySuccessor")
  successors    ActivityDependency[]  @relation("DependencyPredecessor")
  constraints   ActivityConstraint[]
  progress      ActivityProgress[]
  requirements  ResourceRequirement[]

  @@unique([companyId, id])
  @@unique([companyId, planId, id])
  @@unique([planId, workPackageId, taktAreaId])
  @@index([companyId, planId])
  @@map("takt_activities")
}

/// Planned position of an activity in one plan version (cycle index from the
/// version start date, counted in working days × cycle length).
model TaktAssignment {
  id             String   @id @default(uuid(7)) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  planId         String   @map("plan_id") @db.Uuid
  versionId      String   @map("version_id") @db.Uuid
  activityId     String   @map("activity_id") @db.Uuid
  startCycle     Int      @map("start_cycle")
  durationCycles Int      @default(1) @map("duration_cycles")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  version  TaktPlanVersion @relation(fields: [companyId, planId, versionId], references: [companyId, planId, id], onDelete: Cascade)
  activity TaktActivity    @relation(fields: [companyId, planId, activityId], references: [companyId, planId, id], onDelete: Restrict)

  @@unique([companyId, id])
  @@unique([versionId, activityId])
  @@map("takt_assignments")
}

enum DependencyType {
  FS
  SS
  FF
  SF
}

model ActivityDependency {
  id            String         @id @default(uuid(7)) @db.Uuid
  companyId     String         @map("company_id") @db.Uuid
  planId        String         @map("plan_id") @db.Uuid
  predecessorId String         @map("predecessor_id") @db.Uuid
  successorId   String         @map("successor_id") @db.Uuid
  type          DependencyType @default(FS)
  lagDays       Int            @default(0) @map("lag_days")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById   String?        @map("created_by") @db.Uuid

  predecessor TaktActivity @relation("DependencyPredecessor", fields: [companyId, planId, predecessorId], references: [companyId, planId, id], onDelete: Restrict)
  successor   TaktActivity @relation("DependencySuccessor", fields: [companyId, planId, successorId], references: [companyId, planId, id], onDelete: Restrict)

  @@unique([companyId, id])
  @@unique([predecessorId, successorId])
  @@index([companyId, planId])
  @@map("activity_dependencies")
}

enum ConstraintType {
  DRAWINGS
  MATERIAL
  WORKFORCE
  EQUIPMENT
  PERMIT
  AREA
  OTHER
}

enum ConstraintStatus {
  OPEN
  CLEARED
}

/// Readiness constraint. The predecessor check is derived from dependencies.
model ActivityConstraint {
  id          String           @id @default(uuid(7)) @db.Uuid
  companyId   String           @map("company_id") @db.Uuid
  planId      String           @map("plan_id") @db.Uuid
  activityId  String           @map("activity_id") @db.Uuid
  type        ConstraintType
  description String
  dueDate     DateTime?        @map("due_date") @db.Date
  status      ConstraintStatus @default(OPEN)
  clearedAt   DateTime?        @map("cleared_at") @db.Timestamptz(6)
  clearedById String?          @map("cleared_by") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?          @map("created_by") @db.Uuid
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById String?          @map("updated_by") @db.Uuid

  activity TaktActivity @relation(fields: [companyId, planId, activityId], references: [companyId, planId, id], onDelete: Restrict)

  @@unique([companyId, id])
  @@index([companyId, planId, status])
  @@map("activity_constraints")
}

/// Append-only progress history (DB trigger blocks UPDATE/DELETE).
model ActivityProgress {
  id          String   @id @default(uuid(7)) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  planId      String   @map("plan_id") @db.Uuid
  activityId  String   @map("activity_id") @db.Uuid
  reportDate  DateTime @map("report_date") @db.Date
  progressPct Int      @map("progress_pct")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?  @map("created_by") @db.Uuid

  activity TaktActivity @relation(fields: [companyId, planId, activityId], references: [companyId, planId, id], onDelete: Restrict)

  @@unique([companyId, id])
  @@index([companyId, planId, reportDate])
  @@map("activity_progress")
}

enum RequirementKind {
  TRADE
  EQUIPMENT_TYPE
}

/// Resource requirement generated when a version becomes the baseline; the
/// basis for V4–V5 bookings. Immutable (DB trigger).
model ResourceRequirement {
  id              String          @id @default(uuid(7)) @db.Uuid
  companyId       String          @map("company_id") @db.Uuid
  planId          String          @map("plan_id") @db.Uuid
  versionId       String          @map("version_id") @db.Uuid
  activityId      String          @map("activity_id") @db.Uuid
  kind            RequirementKind
  trade           String?
  equipmentTypeId String?         @map("equipment_type_id") @db.Uuid
  quantity        Int
  startDate       DateTime        @map("start_date") @db.Date
  endDate         DateTime        @map("end_date") @db.Date
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  version       TaktPlanVersion @relation(fields: [companyId, planId, versionId], references: [companyId, planId, id], onDelete: Restrict)
  activity      TaktActivity    @relation(fields: [companyId, planId, activityId], references: [companyId, planId, id], onDelete: Restrict)
  equipmentType EquipmentType?  @relation(fields: [companyId, equipmentTypeId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, id])
  @@index([companyId, versionId])
  @@index([companyId, startDate, endDate])
  @@map("resource_requirements")
}

enum ScheduleImportFormat {
  MSPDI
  XER
}

enum ScheduleImportStatus {
  PREVIEW
  APPLIED
  DISCARDED
}

/// MS Project XML / Primavera P6 XER file import. The original file is kept
/// in storage (SHA-256); applying it creates a new DRAFT version.
model ScheduleImport {
  id              String               @id @default(uuid(7)) @db.Uuid
  companyId       String               @map("company_id") @db.Uuid
  planId          String               @map("plan_id") @db.Uuid
  format          ScheduleImportFormat
  fileName        String               @map("file_name")
  sizeBytes       BigInt               @map("size_bytes")
  sha256          String               @db.Char(64)
  storageKey      String               @map("storage_key")
  status          ScheduleImportStatus @default(PREVIEW)
  options         Json
  preview         Json
  resultVersionId String?              @map("result_version_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById     String?              @map("created_by") @db.Uuid
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById     String?              @map("updated_by") @db.Uuid

  plan TaktPlan @relation(fields: [companyId, planId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, id])
  @@index([companyId, planId])
  @@map("schedule_imports")
}
