  status        QuoteVersionStatus @default(DRAFT)
  scope         String?
  overheadPct   Decimal            @default(0) @map("overhead_pct") @db.Decimal(5, 2)
  riskPct       Decimal            @default(0) @map("risk_pct") @db.Decimal(5, 2)
  marginPct     Decimal            @default(0) @map("margin_pct") @db.Decimal(5, 2)
  validUntil    DateTime?          @map("valid_until") @db.Date
  changeReason  String?            @map("change_reason")
  submittedAt   DateTime?          @map("submitted_at") @db.Timestamptz(6)
  submittedById String?            @map("submitted_by") @db.Uuid
  decidedAt     DateTime?          @map("decided_at") @db.Timestamptz(6)
  decidedById   String?            @map("decided_by") @db.Uuid
  decisionNote  String?            @map("decision_note")
  sentAt        DateTime?          @map("sent_at") @db.Timestamptz(6)
  outcomeAt     DateTime?          @map("outcome_at") @db.Timestamptz(6)
  outcomeNote   String?            @map("outcome_note")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById   String?            @map("created_by") @db.Uuid
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById   String?            @map("updated_by") @db.Uuid

  quote    Quote       @relation(fields: [companyId, quoteId], references: [companyId, id], onDelete: Restrict)
