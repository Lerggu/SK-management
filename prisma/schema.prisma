  craneId         String?               @map("crane_id") @db.Uuid
  radiusM         Decimal?              @map("radius_m") @db.Decimal(6, 2)
  craneCapacityKg Decimal?              @map("crane_capacity_kg") @db.Decimal(10, 1)
  areaDescription String?               @map("area_description")
