# ── Database (docker/docker-compose.yml) ─────────────────────────────
DATABASE_URL="postgresql://sk:sk_dev_password@localhost:5432/sk_management"
# Used by integration tests and the migration check (created automatically).
TEST_DATABASE_URL="postgresql://sk:sk_dev_password@localhost:5432/sk_management_test"

# ── Auth.js ──────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Microsoft Entra ID (leave empty to hide the Microsoft button)
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# e.g. https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""

# Dev-only credentials login. Hard-disabled when NODE_ENV=production
# regardless of this flag.
DEV_LOGIN_ENABLED="true"

# ── Object storage (S3-compatible; MinIO locally) ─────────────────────
S3_ENDPOINT="http://localhost:9000"
S3_REGION="eu-north-1"
S3_BUCKET="sk-management-dev"
S3_ACCESS_KEY_ID="sk_minio"
S3_SECRET_ACCESS_KEY="sk_minio_password"
S3_FORCE_PATH_STYLE="true"

# Max upload size in megabytes
UPLOAD_MAX_MB="25"

# ── E-mail (V7: sign-in links for external users, serious-incident alerts) ──
# Leave empty in development to use the dev mailbox at /dev/mailbox.
SMTP_URL=""
MAIL_FROM="SK Management <no-reply@example.com>"
