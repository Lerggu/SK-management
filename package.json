{
  "name": "sk-management",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:migrations": "tsx scripts/migration-check.ts",
    "ai:verify": "tsx scripts/ai-verify.ts",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm depcruise && pnpm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@azure/identity": "^4.13.3",
    "@azure/storage-blob": "^12.34.0",
    "@prisma/client": "^6.19.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "dotenv": "^18.0.5",
    "fast-xml-parser": "^5.11.2",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.14.9",
    "nodemailer": "^10.0.15",
    "pdf-lib": "^1.17.1",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.9"
  }
}
